---
import { playerTracks } from '../../data/music';

const serializedTracks = JSON.stringify(playerTracks);
---

<aside
  class="site-player"
  id="site-music-player"
  aria-label="nabunana 原生音乐播放器"
  data-site-player
  data-state="collapsed"
  data-lyrics-open="false"
  data-drawer-open="false"
  data-pinned="false"
  data-playing="false"
  transition:persist="nabunana-music-player"
>
  <!-- 原生 HTML5 音频引擎 -->
  <audio id="nabunana-audio-element" preload="metadata" data-tracks={serializedTracks}></audio>

  <!-- 1. 浮动在播放器上方的精致多行歌词视窗 -->
  <div
    class="player-lyrics-window"
    id="player-lyrics-window"
    aria-label="双语滚动歌词视窗"
    aria-hidden="true"
  >
    <div class="lyrics-header">
      <div class="lyrics-title-group">
        <span class="lyrics-badge">LYRICS</span>
        <span class="lyrics-song-title" data-lyric-song-title>{playerTracks[0].name}</span>
      </div>
      <button type="button" class="lyrics-close-btn" data-action="toggle-lyrics" aria-label="关闭歌词视窗">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="lyrics-scroller" data-lyrics-scroller>
      <div class="lyrics-list" data-lyrics-list>
        <div class="lyric-status" data-lyric-status>选择歌曲以显示歌词</div>
      </div>
    </div>
  </div>

  <!-- 2. 半屏沉浸式选歌大表抽屉 -->
  <div
    class="player-drawer"
    id="player-drawer"
    aria-label="全曲库选歌面板"
    aria-hidden="true"
  >
    <div class="drawer-header">
      <div class="drawer-header-info">
        <div class="drawer-title-row">
          <h3 class="drawer-title">全部单曲</h3>
          <span class="drawer-count-badge" data-track-count>{playerTracks.length}</span>
        </div>
        <p class="drawer-subtitle">ヨルシカ & n-buna 94 首精选收录</p>
      </div>
      <div class="drawer-search-wrap">
        <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input
          type="text"
          class="drawer-search-input"
          data-drawer-search
          placeholder="搜索单曲、歌手、专辑..."
          autocomplete="off"
          spellcheck="false"
        />
        <button type="button" class="search-clear-btn" data-search-clear aria-label="清空搜索" hidden>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <button type="button" class="drawer-close-btn" data-action="toggle-drawer" aria-label="关闭曲库面板">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="drawer-table-header">
      <div class="col-idx">#</div>
      <div class="col-song">歌曲</div>
      <div class="col-artist">歌手</div>
      <div class="col-album">专辑</div>
    </div>

    <div class="drawer-body" data-drawer-scroll>
      <div class="drawer-track-list" data-drawer-track-list>
        {playerTracks.map((track, index) => (
          <button
            type="button"
            class="track-row"
            data-track-index={index}
            data-search-text={`${track.name} ${track.artist} ${track.album}`.toLowerCase()}
            aria-label={`播放 ${track.name} - ${track.artist}`}
          >
            <div class="col-idx">
              <span class="idx-text">{String(index + 1).padStart(2, '0')}</span>
              <div class="eq-waves" aria-hidden="true">
                <span class="eq-bar bar-1"></span>
                <span class="eq-bar bar-2"></span>
                <span class="eq-bar bar-3"></span>
              </div>
            </div>
            <div class="col-song">
              <img
                src={track.cover.replace('/covers/', '/covers/thumbs/')}
                alt=""
                width="38"
                height="38"
                class="track-cover-thumb"
                loading="lazy"
              />
              <div class="track-meta">
                <span class="track-title-text">{track.name}</span>
                <span class="track-artist-mobile">{track.artist}</span>
              </div>
            </div>
            <div class="col-artist">{track.artist}</div>
            <div class="col-album">{track.album}</div>
          </button>
        ))}
        <div class="drawer-empty" data-no-results hidden>没有找到匹配的歌曲</div>
      </div>
    </div>
  </div>

  <!-- 3. 常驻轻量灵动磨砂玻璃胶囊 -->
  <div class="player-capsule" id="player-capsule">
    <!-- 折叠微态 (Mini Bar) -->
    <div class="capsule-mini-bar" data-capsule-mini>
      <div class="mini-cover-wrap" data-action="expand" role="button" aria-label="展开音乐播放器">
        <img class="mini-cover" data-track-cover src={playerTracks[0].cover.replace('/covers/', '/covers/thumbs/')} alt="" width="34" height="34" />
        <span class="mini-status-dot"></span>
      </div>
      <div class="mini-info" data-action="expand" role="button" aria-label="展开音乐播放器">
        <span class="mini-title" data-track-title>{playerTracks[0].name}</span>
        <span class="mini-artist" data-track-artist>{playerTracks[0].artist}</span>
      </div>
      <div class="mini-actions">
        <button type="button" class="btn-ctrl btn-play-mini" data-action="toggle-play" aria-label="播放/暂停">
          <svg class="icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"/></svg>
          <svg class="icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
        </button>
        <button type="button" class="btn-ctrl btn-expand" data-action="expand" aria-label="展开播放器卡片">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
        </button>
      </div>
    </div>

    <!-- 展开卡片态 (Expanded Card) - 舒适双排布局 -->
    <div class="capsule-expanded-card" data-capsule-expanded>
      <!-- 顶置细长可拖拽进度条 -->
      <div class="progress-wrap" data-progress-wrap role="slider" aria-label="播放进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
        <div class="progress-track">
          <div class="progress-fill" data-progress-fill style="width: 0%;">
            <span class="progress-thumb"></span>
          </div>
        </div>
      </div>

      <div class="card-body">
        <!-- 封面图 (点击可呼出曲库抽屉) -->
        <div class="card-cover-wrap" data-action="toggle-drawer" role="button" aria-label="打开曲库" title="打开全曲库">
          <img class="card-cover" data-track-cover src={playerTracks[0].cover.replace('/covers/', '/covers/thumbs/')} alt="" width="52" height="52" />
          <div class="card-cover-badge" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          </div>
        </div>

        <!-- 卡片右侧双排主体 -->
        <div class="card-main-content">
          <!-- 第 1 排：曲目名称/歌手 + 主播放三键 -->
          <div class="card-row-top">
            <div class="card-meta">
              <span class="card-title" data-track-title>{playerTracks[0].name}</span>
              <span class="card-artist" data-track-artist>{playerTracks[0].artist}</span>
            </div>

            <div class="card-controls">
              <button type="button" class="btn-ctrl btn-prev" data-action="prev" aria-label="上一首" title="上一首">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="19 20 9 12 19 4 19 20"/><line x1="5" y1="19" x2="5" y2="5" stroke="currentColor" stroke-width="2.5"/></svg>
              </button>
              <button type="button" class="btn-ctrl btn-play-card" data-action="toggle-play" aria-label="播放/暂停" title="播放/暂停">
                <svg class="icon-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="7 4 20 12 7 20 7 4"/></svg>
                <svg class="icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
              </button>
              <button type="button" class="btn-ctrl btn-next" data-action="next" aria-label="下一首" title="下一首">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 4 15 12 5 20 5 4"/><line x1="19" y1="5" x2="19" y2="19" stroke="currentColor" stroke-width="2.5"/></svg>
              </button>
            </div>
          </div>

          <!-- 第 2 排：时间指示 + 功能小按键 -->
          <div class="card-row-bottom">
            <div class="card-time">
              <span data-current-time>00:00</span> / <span data-duration>00:00</span>
            </div>

            <div class="card-tools">
              <button type="button" class="btn-tool btn-mode" data-action="toggle-mode" data-mode="loop" aria-label="循环模式: 列表循环" title="列表循环">
                <svg class="mode-icon mode-icon-loop" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/></svg>
                <svg class="mode-icon mode-icon-single" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/><text x="10" y="15" font-size="8" font-family="sans-serif" font-weight="bold" fill="currentColor" stroke="none">1</text></svg>
                <svg class="mode-icon mode-icon-random" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg>
              </button>

              <button type="button" class="btn-tool btn-lyrics" data-action="toggle-lyrics" aria-label="歌词面板" title="显示歌词">
                <span class="btn-lyrics-text">词</span>
              </button>

              <button type="button" class="btn-tool btn-drawer" data-action="toggle-drawer" aria-label="打开全部单曲列表" title="曲库列表">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              </button>

              <button type="button" class="btn-tool btn-pin" data-action="toggle-pin" aria-label="固定播放器" title="固定播放器">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="17" x2="12" y2="22"/><path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.89A4 4 0 0 1 14 9V4h1a1 1 0 0 0 0-2H9a1 1 0 0 0 0 2h1v5a4 4 0 0 1-2.11 3.56l-1.78.89A2 2 0 0 0 5 15.24Z"/></svg>
              </button>

              <button type="button" class="btn-tool btn-collapse" data-action="collapse" aria-label="收起为胶囊" title="收起播放器">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</aside>

<script>
  interface PlayerTrack {
    name: string;
    artist: string;
    url: string;
    lrc: string;
    cover: string;
    album: string;
  }

  interface LyricCue {
    time: number;
    original: string;
    translation: string;
  }

  interface LyricEntry {
    time: number;
    text: string;
  }

  type PlayMode = 'loop' | 'single' | 'random';

  class NabunanaPlayerController {
    root: HTMLElement;
    audio: HTMLAudioElement;
    tracks: PlayerTrack[] = [];
    currentIndex = 0;
    mode: PlayMode = 'loop';
    isPinned = false;
    isLyricsOpen = false;
    isDrawerOpen = false;
    collapseTimer: number | undefined;

    // 歌词状态
    lyricCache = new Map<string, Promise<LyricCue[]>>();
    currentCues: LyricCue[] = [];
    currentCueIndex = -1;
    requestedLrc = '';
    userScrollLocked = false;
    unlockScrollTimer: number | undefined;

    // DOM 元素缓存
    capsuleMini!: HTMLElement;
    capsuleExpanded!: HTMLElement;
    lyricsWindow!: HTMLElement;
    lyricsScroller!: HTMLElement;
    lyricsList!: HTMLElement;
    lyricSongTitle!: HTMLElement;
    drawerWindow!: HTMLElement;
    drawerSearchInput!: HTMLInputElement;
    drawerSearchClear!: HTMLButtonElement;
    drawerTrackList!: HTMLElement;
    drawerCountBadge!: HTMLElement;
    noResultsEl!: HTMLElement;
    trackRows: HTMLButtonElement[] = [];

    // 元数据展示
    titleEls: HTMLElement[] = [];
    artistEls: HTMLElement[] = [];
    coverEls: HTMLImageElement[] = [];
    currentTimeEl!: HTMLElement;
    durationEl!: HTMLElement;
    progressWrap!: HTMLElement;
    progressFill!: HTMLElement;
    modeBtn!: HTMLButtonElement;
    pinBtn!: HTMLButtonElement;
    lyricsBtn!: HTMLButtonElement;
    drawerBtn!: HTMLButtonElement;

    // 进度条拖拽状态
    isSeeking = false;

    constructor(root: HTMLElement) {
      this.root = root;
      this.audio = root.querySelector<HTMLAudioElement>('#nabunana-audio-element')!;
      try {
        this.tracks = JSON.parse(this.audio.dataset.tracks || '[]');
      } catch {
        this.tracks = [];
      }

      if (!this.tracks.length) return;

      this.bindElements();
      this.restorePreferences();
      this.bindEvents();
      this.setupAstroTransitions();
    }

    private bindElements() {
      this.capsuleMini = this.root.querySelector('[data-capsule-mini]')!;
      this.capsuleExpanded = this.root.querySelector('[data-capsule-expanded]')!;
      this.lyricsWindow = this.root.querySelector('#player-lyrics-window')!;
      this.lyricsScroller = this.root.querySelector('[data-lyrics-scroller]')!;
      this.lyricsList = this.root.querySelector('[data-lyrics-list]')!;
      this.lyricSongTitle = this.root.querySelector('[data-lyric-song-title]')!;
      this.drawerWindow = this.root.querySelector('#player-drawer')!;
      this.drawerSearchInput = this.root.querySelector('[data-drawer-search]')!;
      this.drawerSearchClear = this.root.querySelector('[data-search-clear]')!;
      this.drawerTrackList = this.root.querySelector('[data-drawer-track-list]')!;
      this.drawerCountBadge = this.root.querySelector('[data-track-count]')!;
      this.noResultsEl = this.root.querySelector('[data-no-results]')!;
      this.trackRows = Array.from(this.root.querySelectorAll<HTMLButtonElement>('.track-row'));

      this.titleEls = Array.from(this.root.querySelectorAll('[data-track-title]'));
      this.artistEls = Array.from(this.root.querySelectorAll('[data-track-artist]'));
      this.coverEls = Array.from(this.root.querySelectorAll('[data-track-cover]'));
      this.currentTimeEl = this.root.querySelector('[data-current-time]')!;
      this.durationEl = this.root.querySelector('[data-duration]')!;
      this.progressWrap = this.root.querySelector('[data-progress-wrap]')!;
      this.progressFill = this.root.querySelector('[data-progress-fill]')!;

      this.modeBtn = this.root.querySelector('.btn-mode')!;
      this.pinBtn = this.root.querySelector('.btn-pin')!;
      this.lyricsBtn = this.root.querySelector('.btn-lyrics')!;
      this.drawerBtn = this.root.querySelector('.btn-drawer')!;
    }

    private restorePreferences() {
      // 1. 恢复索引
      const savedIndex = Number.parseInt(localStorage.getItem('nabunana-player-index') || '0', 10);
      this.currentIndex = Number.isFinite(savedIndex) && savedIndex >= 0 && savedIndex < this.tracks.length ? savedIndex : 0;

      // 2. 恢复音量
      const savedVolume = Number.parseFloat(localStorage.getItem('nabunana-player-volume') || '0.6');
      this.audio.volume = Number.isFinite(savedVolume) && savedVolume >= 0 && savedVolume <= 1 ? savedVolume : 0.6;

      // 3. 恢复模式
      const savedMode = (localStorage.getItem('nabunana-player-mode') || 'loop') as PlayMode;
      this.mode = ['loop', 'single', 'random'].includes(savedMode) ? savedMode : 'loop';
      this.updateModeUI();

      // 4. 恢复固定与面板状态
      this.isPinned = localStorage.getItem('nabunana-player-pinned') === 'true';
      this.updatePinUI();

      const savedState = localStorage.getItem('nabunana-player-state');
      const expanded = this.isPinned || savedState === 'expanded';
      this.setExpanded(expanded);

      const savedLyrics = localStorage.getItem('nabunana-player-lyrics') === 'true';
      if (savedLyrics) this.setLyricsOpen(true);

      // 加载初始曲目元数据
      this.applyTrackMeta(this.currentIndex);

      // 恢复时间进度
      const savedTime = Number.parseFloat(localStorage.getItem('nabunana-player-time') || '0');
      let initialSeekDone = false;
      this.audio.addEventListener('loadedmetadata', () => {
        if (!initialSeekDone && savedTime > 0 && Number.isFinite(savedTime) && savedTime < this.audio.duration) {
          initialSeekDone = true;
          this.audio.currentTime = savedTime;
          this.updateProgress(savedTime, this.audio.duration);
        }
      }, { once: true });

      // 设置初始 audio 资源
      this.audio.src = this.tracks[this.currentIndex].url;
      this.loadLyrics(this.currentIndex);
    }

    private bindEvents() {
      // 点击动作委派
      this.root.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null;
        if (!target) return;

        const actionBtn = target.closest<HTMLElement>('[data-action]');
        if (actionBtn) {
          const action = actionBtn.dataset.action;
          this.handleAction(action, event);
          return;
        }

        // 点击曲目行
        const row = target.closest<HTMLButtonElement>('.track-row');
        if (row) {
          const idx = Number(row.dataset.trackIndex);
          if (Number.isFinite(idx) && idx >= 0 && idx < this.tracks.length) {
            this.playTrack(idx);
          }
          return;
        }

        // 点击歌词行 Seek
        const lyricLine = target.closest<HTMLElement>('.lyric-line');
        if (lyricLine) {
          const time = Number(lyricLine.dataset.time);
          if (Number.isFinite(time)) {
            this.seekTo(time);
          }
        }
      });

      // 键盘无障碍支持
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (this.isDrawerOpen) this.setDrawerOpen(false);
          else if (this.isLyricsOpen) this.setLyricsOpen(false);
          else if (!this.isPinned && this.root.dataset.state === 'expanded') this.setExpanded(false);
        }
      });

      // 自动折叠交互 (Hover & Focus)
      const coarsePointer = matchMedia('(hover: none), (pointer: coarse)');
      this.root.addEventListener('pointerenter', () => {
        if (!coarsePointer.matches) this.setExpanded(true);
      });
      this.root.addEventListener('pointerleave', () => {
        if (!coarsePointer.matches) this.scheduleCollapse();
      });
      this.root.addEventListener('focusin', () => this.setExpanded(true));
      this.root.addEventListener('focusout', (event) => {
        if (!this.root.contains(event.relatedTarget as Node | null)) this.scheduleCollapse();
      });

      // 搜索功能
      this.drawerSearchInput.addEventListener('input', () => {
        const query = this.drawerSearchInput.value.trim().toLowerCase();
        this.filterDrawerTracks(query);
      });
      this.drawerSearchClear.addEventListener('click', () => {
        this.drawerSearchInput.value = '';
        this.filterDrawerTracks('');
        this.drawerSearchInput.focus();
      });

      // 进度条拖动 Seek
      this.setupProgressBar();

      // 歌词滚动防打扰检测
      this.lyricsScroller.addEventListener('wheel', () => this.lockAutoScroll(), { passive: true });
      this.lyricsScroller.addEventListener('touchmove', () => this.lockAutoScroll(), { passive: true });

      // Audio 播放事件
      this.audio.addEventListener('play', () => {
        this.root.dataset.playing = 'true';
        this.dispatchPlayerState(true);
        this.setExpanded(true);
        this.scheduleCollapse(3000);
      });
      this.audio.addEventListener('pause', () => {
        this.root.dataset.playing = 'false';
        this.dispatchPlayerState(false);
      });
      this.audio.addEventListener('ended', () => {
        if (this.mode === 'single') {
          this.audio.currentTime = 0;
          this.audio.play();
        } else {
          this.next();
        }
      });
      this.audio.addEventListener('timeupdate', () => {
        if (!this.isSeeking) {
          const cur = this.audio.currentTime;
          const dur = this.audio.duration || 0;
          this.updateProgress(cur, dur);
          this.syncLyrics(cur);
          // 每 3 秒记录一次进度
          if (Math.floor(cur) % 3 === 0) {
            localStorage.setItem('nabunana-player-time', String(cur));
          }
        }
      });
      this.audio.addEventListener('loadedmetadata', () => {
        this.durationEl.textContent = this.formatTime(this.audio.duration || 0);
      });
      this.audio.addEventListener('volumechange', () => {
        localStorage.setItem('nabunana-player-volume', String(this.audio.volume));
      });

      // 全站联动事件
      window.addEventListener('nabunana:play-track', (e) => {
        const index = (e as CustomEvent<number>).detail;
        if (Number.isFinite(index) && index >= 0 && index < this.tracks.length) {
          this.playTrack(index);
        }
      });
      window.addEventListener('nabunana:toggle-play', () => {
        this.togglePlay();
      });
    }

    private setupAstroTransitions() {
      document.addEventListener('astro:before-swap', () => {
        localStorage.setItem('nabunana-player-time', String(this.audio.currentTime || 0));
      });
      window.addEventListener('pagehide', () => {
        localStorage.setItem('nabunana-player-time', String(this.audio.currentTime || 0));
      });
    }

    private handleAction(action?: string, event?: Event) {
      if (!action) return;
      if (event) {
        event.stopPropagation();
      }
      switch (action) {
        case 'toggle-play':
          this.togglePlay();
          break;
        case 'prev':
          this.prev();
          break;
        case 'next':
          this.next();
          break;
        case 'expand':
          this.setExpanded(true);
          break;
        case 'collapse':
          if (this.isPinned) this.setPinned(false);
          this.setExpanded(false);
          break;
        case 'toggle-pin':
          this.setPinned(!this.isPinned);
          break;
        case 'toggle-lyrics':
          this.setLyricsOpen(!this.isLyricsOpen);
          break;
        case 'toggle-drawer':
          this.setDrawerOpen(!this.isDrawerOpen);
          break;
        case 'toggle-mode':
          this.toggleMode();
          break;
      }
    }

    public togglePlay() {
      if (this.audio.paused) {
        this.audio.play().catch(() => {});
      } else {
        this.audio.pause();
      }
    }

    public playTrack(index: number) {
      if (index < 0 || index >= this.tracks.length) return;
      if (this.currentIndex === index && this.audio.src.includes(this.tracks[index].url)) {
        if (this.audio.paused) {
          this.audio.play().catch(() => {});
        }
        return;
      }
      this.currentIndex = index;
      localStorage.setItem('nabunana-player-index', String(index));
      localStorage.setItem('nabunana-player-time', '0');

      this.audio.src = this.tracks[index].url;
      this.applyTrackMeta(index);
      this.loadLyrics(index);
      this.audio.play().catch(() => {});
      this.dispatchPlayerState(true);
    }

    public next() {
      let nextIndex: number;
      if (this.mode === 'random' && this.tracks.length > 1) {
        do {
          nextIndex = Math.floor(Math.random() * this.tracks.length);
        } while (nextIndex === this.currentIndex);
      } else {
        nextIndex = (this.currentIndex + 1) % this.tracks.length;
      }
      this.playTrack(nextIndex);
    }

    public prev() {
      if (this.audio.currentTime > 3) {
        this.audio.currentTime = 0;
        return;
      }
      const prevIndex = (this.currentIndex - 1 + this.tracks.length) % this.tracks.length;
      this.playTrack(prevIndex);
    }

    public toggleMode() {
      const modes: PlayMode[] = ['loop', 'single', 'random'];
      const nextMode = modes[(modes.indexOf(this.mode) + 1) % modes.length];
      this.mode = nextMode;
      localStorage.setItem('nabunana-player-mode', nextMode);
      this.updateModeUI();
    }

    private updateModeUI() {
      this.modeBtn.dataset.mode = this.mode;
      const titles: Record<PlayMode, string> = {
        loop: '列表循环',
        single: '单曲循环',
        random: '随机播放',
      };
      this.modeBtn.title = titles[this.mode];
      this.modeBtn.setAttribute('aria-label', `循环模式: ${titles[this.mode]}`);
    }

    public setExpanded(expanded: boolean) {
      window.clearTimeout(this.collapseTimer);
      if (!expanded && (this.isDrawerOpen || this.isLyricsOpen)) {
        this.setDrawerOpen(false);
        this.setLyricsOpen(false);
      }
      this.root.dataset.state = expanded ? 'expanded' : 'collapsed';
      localStorage.setItem('nabunana-player-state', expanded ? 'expanded' : 'collapsed');
    }

    public scheduleCollapse(delay = 2500) {
      window.clearTimeout(this.collapseTimer);
      if (this.isPinned || this.isDrawerOpen || this.isLyricsOpen) return;
      this.collapseTimer = window.setTimeout(() => {
        if (!this.isPinned && !this.isDrawerOpen && !this.isLyricsOpen && !this.root.matches(':hover') && !this.root.contains(document.activeElement)) {
          this.setExpanded(false);
        }
      }, delay);
    }

    public setPinned(pinned: boolean) {
      this.isPinned = pinned;
      localStorage.setItem('nabunana-player-pinned', String(pinned));
      this.updatePinUI();
      if (pinned) {
        this.setExpanded(true);
      } else {
        this.scheduleCollapse();
      }
    }

    private updatePinUI() {
      this.root.dataset.pinned = String(this.isPinned);
      this.pinBtn.setAttribute('aria-pressed', String(this.isPinned));
      this.pinBtn.title = this.isPinned ? '取消固定' : '固定播放器';
    }

    public setLyricsOpen(open: boolean) {
      this.isLyricsOpen = open;
      this.root.dataset.lyricsOpen = String(open);
      this.lyricsWindow.setAttribute('aria-hidden', String(!open));
      this.lyricsBtn.setAttribute('aria-pressed', String(open));
      localStorage.setItem('nabunana-player-lyrics', String(open));
      if (open) {
        this.setExpanded(true);
        this.scrollToActiveLyric(true);
      } else {
        this.scheduleCollapse();
      }
    }

    public setDrawerOpen(open: boolean) {
      this.isDrawerOpen = open;
      this.root.dataset.drawerOpen = String(open);
      this.drawerWindow.setAttribute('aria-hidden', String(!open));
      this.drawerBtn.setAttribute('aria-pressed', String(open));
      if (open) {
        this.setExpanded(true);
        // 自动聚焦搜索框并滚到当前音轨
        requestAnimationFrame(() => {
          this.drawerSearchInput.focus();
          const activeRow = this.trackRows[this.currentIndex];
          if (activeRow) activeRow.scrollIntoView({ block: 'nearest' });
        });
      } else {
        this.scheduleCollapse();
      }
    }

    private applyTrackMeta(index: number) {
      const track = this.tracks[index];
      if (!track) return;

      const thumbCover = track.cover.replace('/covers/', '/covers/thumbs/');

      this.titleEls.forEach((el) => { el.textContent = track.name; });
      this.artistEls.forEach((el) => { el.textContent = track.artist; });
      this.coverEls.forEach((img) => { img.src = thumbCover; });
      if (this.lyricSongTitle) this.lyricSongTitle.textContent = track.name;

      // 更新曲库大表高亮项
      this.trackRows.forEach((row, rIdx) => {
        const isActive = rIdx === index;
        row.classList.toggle('is-active', isActive);
        row.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
    }

    private dispatchPlayerState(playing: boolean) {
      const cur = this.tracks[this.currentIndex];
      window.dispatchEvent(new CustomEvent('nabunana:player-state', {
        detail: {
          playing,
          trackIndex: this.currentIndex,
          album: cur?.album,
          title: cur?.name || 'ノーチラス',
          artist: cur?.artist || 'Yorushika'
        }
      }));
    }

    // --- 进度条逻辑 ---
    private setupProgressBar() {
      let isDragging = false;

      const updateSeekFromEvent = (e: MouseEvent | TouchEvent) => {
        const rect = this.progressWrap.getBoundingClientRect();
        const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
        const ratio = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
        const targetTime = ratio * (this.audio.duration || 0);
        this.updateProgress(targetTime, this.audio.duration || 0);
        return targetTime;
      };

      const startSeek = (e: MouseEvent | TouchEvent) => {
        isDragging = true;
        this.isSeeking = true;
        updateSeekFromEvent(e);
        const onMove = (moveEvt: MouseEvent | TouchEvent) => {
          if (!isDragging) return;
          updateSeekFromEvent(moveEvt);
        };
        const onEnd = (endEvt: MouseEvent | TouchEvent) => {
          if (!isDragging) return;
          isDragging = false;
          const finalTime = updateSeekFromEvent(endEvt);
          this.audio.currentTime = finalTime;
          this.isSeeking = false;
          window.removeEventListener('mousemove', onMove);
          window.removeEventListener('mouseup', onEnd);
          window.removeEventListener('touchmove', onMove);
          window.removeEventListener('touchend', onEnd);
        };

        window.addEventListener('mousemove', onMove);
        window.addEventListener('mouseup', onEnd);
        window.addEventListener('touchmove', onMove);
        window.addEventListener('touchend', onEnd);
      };

      this.progressWrap.addEventListener('mousedown', startSeek);
      this.progressWrap.addEventListener('touchstart', startSeek, { passive: true });
    }

    private seekTo(time: number) {
      if (!Number.isFinite(time) || time < 0) return;
      const targetTime = Math.max(0, time);

      const performSeek = () => {
        try {
          this.audio.currentTime = targetTime;
          this.updateProgress(targetTime, this.audio.duration || 0);
          this.syncLyrics(targetTime);
          this.scrollToActiveLyric(true);
        } catch (e) {
          console.warn('Seek error:', e);
        }
      };

      if (this.audio.paused) {
        const playPromise = this.audio.play();
        if (playPromise !== undefined) {
          playPromise.then(() => performSeek()).catch(() => performSeek());
        } else {
          performSeek();
        }
      } else {
        performSeek();
      }
    }

    private updateProgress(current: number, duration: number) {
      const percent = duration > 0 ? (current / duration) * 100 : 0;
      this.progressFill.style.width = `${percent.toFixed(2)}%`;
      this.currentTimeEl.textContent = this.formatTime(current);
      if (duration > 0) {
        this.durationEl.textContent = this.formatTime(duration);
      }
      this.progressWrap.setAttribute('aria-valuenow', String(Math.round(percent)));
    }

    private formatTime(seconds: number): string {
      const sec = Math.floor(seconds || 0);
      const m = Math.floor(sec / 60);
      const s = sec % 60;
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }

    // --- 歌词解析与渲染 ---
    private parseLrc(source: string): LyricCue[] {
      const entries: LyricEntry[] = [];
      source.split(/\r?\n/).forEach((line) => {
        const text = line.replace(/^.*\](?=[^\]]*$)/, '').trim();
        if (!text) return;
        for (const match of line.matchAll(/\[(\d{1,2}):(\d{2})(?:[.:](\d{1,3}))?\]/g)) {
          const fraction = (match[3] || '0').padEnd(3, '0').slice(0, 3);
          entries.push({ time: Number(match[1]) * 60 + Number(match[2]) + Number(fraction) / 1000, text });
        }
      });
      entries.sort((a, b) => a.time - b.time);

      const kana = /[ぁ-んァ-ヶー]/;
      const han = /[\u3400-\u9fff]/;
      const samplePairs = Math.min(Math.floor(entries.length / 2), 20);
      let bilingualSamples = 0;
      for (let index = 0; index < samplePairs; index += 1) {
        const original = entries[index * 2]?.text || '';
        const translation = entries[index * 2 + 1]?.text || '';
        if (kana.test(original) && !kana.test(translation) && han.test(translation)) bilingualSamples += 1;
      }
      const bilingual = samplePairs >= 3 && bilingualSamples / samplePairs >= 0.45;

      const cues: LyricCue[] = [];
      if (bilingual) {
        for (let index = 0; index < entries.length; index += 2) {
          cues.push({ time: entries[index].time, original: entries[index].text, translation: entries[index + 1]?.text || '' });
        }
      } else {
        entries.forEach((entry) => cues.push({ time: entry.time, original: entry.text, translation: '' }));
      }
      return cues;
    }

    private async loadLyrics(index: number) {
      const lrc = this.tracks[index]?.lrc;
      this.requestedLrc = lrc || '';
      this.currentCues = [];
      this.currentCueIndex = -1;

      if (!lrc) {
        this.renderLyricsEmpty('♪ 纯音乐 / Instrumental');
        return;
      }

      this.renderLyricsEmpty('歌词加载中…');

      try {
        if (!this.lyricCache.has(lrc)) {
          this.lyricCache.set(lrc, fetch(lrc).then((r) => {
            if (!r.ok) throw new Error(`Lyric failed: ${r.status}`);
            return r.text();
          }).then((text) => this.parseLrc(text)));
        }

        const cues = await this.lyricCache.get(lrc)!;
        if (this.requestedLrc !== lrc) return;

        this.currentCues = cues;
        if (!cues.length) {
          this.renderLyricsEmpty('♪ 纯音乐 / Instrumental');
          return;
        }

        this.renderLyricsCues(cues);
        this.syncLyrics(this.audio.currentTime || 0);
        this.scrollToActiveLyric(true);
      } catch {
        if (this.requestedLrc === lrc) {
          this.renderLyricsEmpty('暂无歌词或加载失败');
        }
      }
    }

    private renderLyricsEmpty(text: string) {
      this.lyricsList.innerHTML = `<div class="lyric-status">${text}</div>`;
    }

    private renderLyricsCues(cues: LyricCue[]) {
      const html = cues.map((cue, idx) => `
        <div class="lyric-line" data-cue-index="${idx}" data-time="${cue.time}">
          <p class="lyric-orig">${this.escapeHtml(cue.original)}</p>
          ${cue.translation ? `<p class="lyric-trans">${this.escapeHtml(cue.translation)}</p>` : ''}
        </div>
      `).join('');
      this.lyricsList.innerHTML = html;
    }

    private syncLyrics(time: number) {
      if (!this.currentCues.length) return;
      let low = 0;
      let high = this.currentCues.length - 1;
      let found = 0;
      while (low <= high) {
        const mid = (low + high) >> 1;
        if (this.currentCues[mid].time <= time) {
          found = mid;
          low = mid + 1;
        } else {
          high = mid - 1;
        }
      }

      if (found !== this.currentCueIndex) {
        this.currentCueIndex = found;
        const allLines = this.lyricsList.querySelectorAll('.lyric-line');
        allLines.forEach((line, idx) => {
          line.classList.toggle('is-active', idx === found);
        });
        if (!this.userScrollLocked && this.isLyricsOpen) {
          this.scrollToActiveLyric();
        }
      }
    }

    private scrollToActiveLyric(force = false) {
      if (!this.isLyricsOpen) return;
      const activeLine = this.lyricsList.querySelector<HTMLElement>(`.lyric-line[data-cue-index="${this.currentCueIndex}"]`);
      if (activeLine) {
        activeLine.scrollIntoView({ behavior: force ? 'auto' : 'smooth', block: 'center' });
      }
    }

    private lockAutoScroll() {
      this.userScrollLocked = true;
      window.clearTimeout(this.unlockScrollTimer);
      this.unlockScrollTimer = window.setTimeout(() => {
        this.userScrollLocked = false;
        this.scrollToActiveLyric();
      }, 3500);
    }

    private escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // --- 曲库搜索过滤 ---
    private filterDrawerTracks(query: string) {
      const q = query.trim().toLowerCase();
      this.drawerSearchClear.hidden = !q;

      let matchCount = 0;
      this.trackRows.forEach((row) => {
        const text = row.dataset.searchText || '';
        const match = !q || text.includes(q);
        row.hidden = !match;
        row.style.display = match ? '' : 'none';
        if (match) matchCount += 1;
      });

      this.drawerCountBadge.textContent = String(matchCount);
      this.noResultsEl.hidden = matchCount > 0;
      this.noResultsEl.style.display = matchCount > 0 ? 'none' : 'block';
    }
  }

  // 单例保护，避免 Astro 页面切换重复绑定
  declare global {
    interface Window {
      __nabunanaPlayerInstance?: NabunanaPlayerController;
    }
  }

  function initPlayer() {
    const playerRoot = document.querySelector<HTMLElement>('#site-music-player');
    if (!playerRoot) return;

    if (!window.__nabunanaPlayerInstance) {
      window.__nabunanaPlayerInstance = new NabunanaPlayerController(playerRoot);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPlayer);
  } else {
    initPlayer();
  }
</script>

