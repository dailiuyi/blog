---
interface Props { eyebrow: string; title: string; description: string; count?: string; }
const { eyebrow, title, description, count } = Astro.props;
---
<header class="page-hero container"><p class="eyebrow">{eyebrow}{count && <span>{count}</span>}</p><h1>{title}</h1><div class="page-description"><slot>{description}</slot></div></header>
<style>
  .page-hero{padding-block:72px 48px;border-bottom:1px solid var(--border)}.eyebrow{display:flex;gap:25px;align-items:center}.eyebrow span{color:var(--accent-deep)}h1{font:550 clamp(32px,4.5vw,54px)/1.25 var(--font-sans);letter-spacing:-.05em;white-space:pre-line;margin:24px 0 20px}.page-description{font-size:15px;line-height:1.9;max-width:620px;color:var(--muted)}@media(max-width:600px){.page-hero{padding-block:48px 32px}.page-description{font-size:14px}}
</style>
