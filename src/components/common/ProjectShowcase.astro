---
import ProjectPreview from './ProjectPreview.astro';
import { selectedProjects, type ProjectCard } from '../../data/selected-projects';
interface Props { projects?: readonly ProjectCard[]; }
const { projects = selectedProjects } = Astro.props;
const sourceLabel = (project: ProjectCard) => project.id === 'minialloc' ? '源码节选出处' : project.id === 'cardpdf' ? '排版示意图：按工具输出规格绘制' : '预览素材来自项目仓库';
---
<div class="project-showcase">{projects.map((project, index) => <article class="showcase-card">
  <ProjectPreview id={project.id} />
  <div class="showcase-copy"><p class="kicker">0{index + 1} / {project.subtitle}</p><h3>{project.name}</h3><p class="showcase-description">{project.description}</p><p class="showcase-detail">{project.detail}</p><ul class="tech-tags" aria-label="技术栈">{project.tech.map(tech => <li>{tech}</li>)}</ul><div class="showcase-links"><a href={project.article}>阅读构建记录 ↗</a>{'live' in project && <a href={project.live} target="_blank" rel="noopener noreferrer">在线体验 ↗</a>}<a href={project.repo} target="_blank" rel="noopener noreferrer">源码 ↗</a></div><a class="source-link" href={project.source} target="_blank" rel="noopener noreferrer">{sourceLabel(project)} ↗</a></div>
</article>)}</div>
<style>
  .project-showcase{display:grid;gap:28px}.showcase-card{display:grid;grid-template-columns:1.15fr 1fr;gap:clamp(28px,5vw,64px);align-items:center;padding:24px;border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface)}.showcase-card:nth-child(even)>:first-child{order:2}.showcase-copy{padding:12px 12px 12px 0;min-width:0}.kicker{font:11px/1.7 var(--font-mono);color:var(--muted);margin:0 0 18px}h3{font:600 clamp(25px,3vw,38px)/1.2 var(--font-sans);letter-spacing:-.045em;margin:0 0 20px}.showcase-description{font-size:15px;line-height:1.9;margin:0 0 12px}.showcase-detail{font-size:13px;line-height:1.8;color:var(--muted);margin:0}.tech-tags{display:flex;flex-wrap:wrap;gap:8px;padding:0;list-style:none;margin:22px 0}.tech-tags li{font:10px/1.5 var(--font-mono);padding:5px 8px;border:1px solid var(--border);border-radius:4px;color:var(--muted)}.showcase-links{display:flex;flex-wrap:wrap;gap:12px 20px;font-size:12px;color:var(--accent-deep)}.showcase-links a{padding-block:6px}.source-link{display:inline-block;margin-top:16px;font-size:10px;color:var(--muted)}a:hover{text-decoration:underline;text-underline-offset:4px}
  .showcase-card:nth-child(even) :global(.project-preview){order:2}
  @media(max-width:760px){.showcase-card{grid-template-columns:1fr;padding:14px;gap:20px;border-radius:16px}.showcase-card:nth-child(even) :global(.project-preview){order:0}.showcase-copy{padding:4px 8px 12px}.showcase-description{font-size:14px}.kicker{margin-bottom:10px}h3{margin-bottom:14px}}
</style>
