---
interface Props { current?: 'home' | 'writing' | 'music' | 'projects' | 'about'; }
const { current } = Astro.props;
const links = [
  { key: 'home', label: '首页', sub: 'Home', href: '/' },
  { key: 'projects', label: '作品', sub: 'Projects', href: '/projects/' },
  { key: 'writing', label: '文章', sub: 'Writing', href: '/blog/' },
  { key: 'music', label: '音乐', sub: 'Music', href: '/music/' },
  { key: 'about', label: '关于', sub: 'About', href: '/about/' },
] as const;
---

<a class="sr-only skip-link" href="#main">跳到正文</a>
<header class="site-header container">
  <a class="site-brand" href="/" aria-label="nabunana 首页"><b>nabunana</b></a>
  <nav aria-label="主导航">{links.map((link) => <a href={link.href} aria-current={current === link.key ? 'page' : undefined}><span>{link.label}</span><small>{link.sub}</small></a>)}</nav>
  <div class="header-actions"><a class="header-action github-link" href="https://github.com/dailiuyi" target="_blank" rel="me noopener" aria-label="dailiuyi 的 GitHub"><svg aria-hidden="true" viewBox="0 0 16 16"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg><span>GitHub</span></a><button class="header-action search-action" type="button" data-search-open aria-label="打开搜索"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg><span>Search</span><kbd class="search-kbd" aria-hidden="true">⌘K</kbd></button></div>
  <details class="mobile-menu"><summary aria-label="打开导航">Menu</summary><div>{links.map((link) => <a href={link.href} aria-current={current === link.key ? 'page' : undefined}>{link.label} / {link.sub}</a>)}<a href="https://github.com/dailiuyi" target="_blank" rel="me noopener">GitHub ↗</a></div></details>
</header>

<style>
  .site-header{height:72px;display:flex;align-items:center;justify-content:space-between;gap:2rem;border-bottom:1px solid var(--border)}.site-brand{display:flex;align-items:center;font-family:var(--font-serif)}.site-brand b{font-weight:600;letter-spacing:-.02em}.site-header nav{display:flex;align-items:center;gap:1.7rem}.site-header nav a{display:grid;color:var(--muted);font-size:.72rem;line-height:1.25;transition:color .2s var(--ease)}.site-header nav a span{width:max-content;background:linear-gradient(currentColor,currentColor) 0 100%/0 1px no-repeat;transition:background-size .22s var(--ease)}.site-header nav a small{font-size:.52rem;letter-spacing:.08em;opacity:.7}.site-header nav a:hover,.site-header nav a[aria-current='page']{color:var(--text)}.site-header nav a:hover span,.site-header nav a[aria-current='page'] span{background-size:100% 1px}.header-actions{display:flex;align-items:center;gap:.35rem}.header-action{box-sizing:border-box;width:124px;height:38px;display:inline-flex;align-items:center;justify-content:center;gap:.45rem;padding:0 .7rem;border:1px solid var(--border);border-radius:999px;background:color-mix(in srgb,var(--surface) 80%,transparent);color:var(--text);font:600 .62rem/1 var(--font-sans);cursor:pointer;transition:background .2s,border-color .2s,transform .2s var(--ease)}.header-action:hover{background:var(--surface-2);transform:translateY(-1px)}.search-action{width:auto;min-width:116px;padding:0 .8rem}.search-action svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round}.github-link svg{width:14px;height:14px;flex-shrink:0;fill:currentColor}.search-kbd{display:inline-flex;align-items:center;padding:1px 5px;border:1px solid var(--border);border-radius:4px;background:var(--surface-2);color:var(--muted);font:500 9px/1.2 var(--font-mono);letter-spacing:.02em;margin-left:2px}.mobile-menu{display:none;position:relative}.mobile-menu summary{list-style:none;padding:.55rem .65rem;border:1px solid var(--border);border-radius:6px;color:var(--text);font:.65rem var(--font-mono);cursor:pointer}.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu>div{position:absolute;z-index:40;right:0;top:calc(100% + .5rem);width:210px;padding:.5rem;border:1px solid var(--border);border-radius:8px;background:var(--surface);box-shadow:0 12px 40px rgb(25 91 86 / 8%)}.mobile-menu a{display:block;padding:.7rem;color:var(--muted);font-size:.75rem}.mobile-menu a[aria-current='page']{color:var(--accent-deep)}
  @media(max-width:800px){.site-header{gap:.6rem}.site-header nav{display:none}.github-link{display:none}.search-action{width:38px;min-width:38px;padding:0}.search-action span,.search-action .search-kbd{display:none}.mobile-menu{display:block}}
  /* 跳过导航链接。SiteHeader 是 body 的直接子元素，会命中 global.css 的
     `body > :not(...) { position: relative; z-index: 1 }`，该选择器优先级高于
     `.sr-only`，因此这里用 !important 把链接固定到视口左上，并保证它在 Header 之上。 */
  .skip-link{position:fixed!important;top:12px;left:12px;z-index:200!important}
  .skip-link:focus-visible{width:auto;height:auto;margin:0;padding:.55rem .95rem;overflow:visible;clip:auto;white-space:nowrap;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:var(--radius-sm);box-shadow:var(--shadow);font-size:.8rem;font-weight:600;line-height:1.2}
</style>
