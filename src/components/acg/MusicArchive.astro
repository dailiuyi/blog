---
import type { CollectionEntry } from 'astro:content';
import MotionBlock from '../common/MotionBlock.astro';
import WindWaveMotif from './WindWaveMotif.astro';
import SiteHeader from '../common/SiteHeader.astro';
import { albumStartIndexes, musicAlbums } from '../../data/music';
interface Props { posts: CollectionEntry<'blog'>[]; prototype?: boolean; }
const { posts, prototype = false } = Astro.props;
const musicPosts = posts.filter((post) => /music|acg|音乐|动画/i.test(`${post.data.category} ${post.data.tags.join(' ')}`));
---

<main class="music-archive" data-music-root>
  {prototype ? <header class="music-nav container"><a class="brand" href="/prototype/acg/"><span>N</span><i></i> nabunana</a><nav aria-label="音乐页导航"><a href="#listening">Now Listening</a><a href="#artists">Artists</a><a href="#vocaloid">Vocaloid</a><a href="#notes">Notes</a></nav><div><button type="button" data-search-open aria-label="打开搜索">⌕</button></div></header> : <SiteHeader current="music" />}

<MotionBlock enabled={!prototype} follow="motif">  <section class="music-hero container" data-editorial-depth data-reveal-group><div><p data-scroll-reveal>音楽 / MUSIC ARCHIVE</p><h1 data-scroll-reveal>夜の音、<br /><em>夏の記憶。</em></h1><span data-scroll-reveal>Music I return to, and the fragments it leaves behind.</span></div><WindWaveMotif /><b aria-hidden="true">SIDE A<br />2026</b></section></MotionBlock>

  <section class="now-listening container" id="listening" data-editorial-depth data-reveal-group>
<MotionBlock enabled={!prototype}>    <header data-scroll-reveal><span>01</span><p>今聴いている</p><h2>NOW LISTENING</h2></header></MotionBlock>
<MotionBlock enabled={!prototype}>    <div class="library-summary"><div><small>PERSONAL MUSIC LIBRARY</small><h3>n-buna / ヨルシカ</h3></div><p>七张专辑、九十四首歌与逐曲同步歌词。点击任意封面，从这张专辑的第一首开始播放。</p><time>7 ALBUMS / 94 TRACKS</time></div></MotionBlock>
    <div class="music-album-grid">
      {musicAlbums.map((album, index) => (
<MotionBlock enabled={!prototype} hover="media" follow="media">        <button type="button" class="music-album-card" data-play-index={albumStartIndexes[album.slug]} data-scroll-reveal aria-label={`播放 ${album.artist} 的专辑《${album.title}》`}>
          <span class="music-album-cover"><img data-motion-media src={album.cover} alt={`${album.title} 专辑封面`} width="900" height="900" loading={index < 3 ? 'eager' : 'lazy'} /><i aria-hidden="true">▶</i></span>
          <span class="music-album-meta"><small>{album.year} / {album.tracks.length} TRACKS</small><strong>{album.title}</strong><em>{album.artist}</em></span>
        </button></MotionBlock>
      ))}
    </div>
  </section>

<MotionBlock enabled={!prototype}>  <section class="artists" id="artists" data-reveal-group><div class="container"><header data-scroll-reveal><span>02</span><p>好きな音</p><h2>ARTISTS & INFLUENCES</h2></header><div class="artist-list"><article data-scroll-reveal><b>01</b><h3>Yorushika</h3><p>文学性、透明感、吉他与季节的记忆。</p><span>ヨルシカ</span></article><article data-scroll-reveal><b>02</b><h3>n-buna</h3><p>Vocaloid 创作、青春与难以言明的情绪。</p><span>ナブナ</span></article><article class="placeholder" data-scroll-reveal><b>03</b><h3>More later</h3><p>不自动虚构其他偏好，等待真实的音乐记录。</p><span>未整理</span></article></div></div></section></MotionBlock>

  <section class="vocaloid container" id="vocaloid" data-editorial-depth data-reveal-group><MotionBlock enabled={!prototype}><header data-scroll-reveal><span>03</span><p>ボカロ</p><h2>VOCALOID ARCHIVE</h2></header></MotionBlock><div class="archive-layout"><MotionBlock enabled={!prototype}><div class="archive-intro" data-scroll-reveal><p>把术力口当作一座音乐档案馆，而不是贴纸墙。</p><strong>VOICE<br />BECOMES<br />MEMORY.</strong></div></MotionBlock><div class="archive-rows">{musicAlbums.map((album) => <MotionBlock enabled={!prototype}><article data-scroll-reveal><span>{album.year} / {album.tracks.length} TRACKS</span><h3>{album.title}</h3><p>{album.artist} · 已加入全站播放列表。</p></article></MotionBlock>)}</div></div></section>

  <section class="music-notes container" id="notes" data-editorial-depth data-reveal-group><MotionBlock enabled={!prototype}><header data-scroll-reveal><span>04</span><p>音楽の文章</p><h2>MUSIC NOTES</h2></header></MotionBlock>{musicPosts.length ? <div class="note-list">{musicPosts.map((post) => <MotionBlock enabled={!prototype} hover="row"><a href={`/blog/${post.id}/`} data-scroll-reveal><small>{post.data.category}</small><h3><span data-motion-title>{post.data.title}</span></h3><p>{post.data.description}</p><span data-motion-arrow>↗</span></a></MotionBlock>)}</div> : <MotionBlock enabled={!prototype}><div class="empty-notes" data-scroll-reveal><strong>第一篇音乐笔记，正在等待被写下。</strong><p>这里不会用伪造文章填满版面。</p></div></MotionBlock>}</section>

<MotionBlock enabled={!prototype}>  <section class="music-future"><div class="container future-grid"><article><span>05 / PLAYLISTS</span><h3>7 Albums / 94 Tracks</h3><p>逐曲歌词、播放位置和音量都会保留在浏览器中。</p></article><article><span>06 / LIVE</span><h3>演出记录</h3><p>等待真实现场经历。</p></article><article><span>07 / HISTORY</span><h3>听歌历史</h3><p>只在有可靠数据源时接入。</p></article></div></section></MotionBlock>

<MotionBlock enabled={!prototype}>  <footer><WindWaveMotif compact /><div class="container"><strong>音楽は、まだ続いている。</strong><p>Music, writing, code — all in one personal space.</p><a href={prototype ? '/prototype/acg/' : '/'}>返回 {prototype ? 'ACG Prototype' : 'Home'} ↗</a></div></footer></MotionBlock>
</main>

<script>
  let musicArchiveAbort: AbortController | undefined;
  const bindMusicArchive = () => {
    musicArchiveAbort?.abort();
    musicArchiveAbort = new AbortController();
    const { signal } = musicArchiveAbort;
    const musicRoot = document.querySelector<HTMLElement>('[data-music-root]');
    if (!musicRoot) return;
    document.querySelectorAll<HTMLButtonElement>('.music-album-card[data-play-index]').forEach((button) => button.addEventListener('click', () => {
      const index = Number.parseInt(button.dataset.playIndex || '0', 10);
      window.dispatchEvent(new CustomEvent('nabunana:play-track', { detail: index }));
    }, { signal }));
  };
  document.addEventListener('astro:page-load', bindMusicArchive);
  bindMusicArchive();
</script>

<style>
  :global(.acg-music),:global(.prototype-acg){--bg:#f5fbfa;--surface:#fff;--surface-2:#edf7f5;--text:#173b3a;--strong:#102e2d;--muted:#64817f;--accent:#3dafa5;--accent-deep:#216e69;--border:rgb(39 108 103 / 14%)}
  :global(:root[data-theme='dark'] .acg-music){--bg:#102724;--surface:#18332f;--surface-2:#1e3b36;--text:#e7f0ed;--strong:#f3f8f6;--muted:#9eb3ae;--accent:#78c5bb;--accent-deep:#58aaa0;--border:rgb(174 222 215 / 15%)}
  .music-archive{min-height:100vh;background:transparent;color:var(--text);overflow:clip}
  .music-nav{height:72px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border)}.brand{display:flex;align-items:center;gap:.5rem;font:600 .85rem var(--font-serif)}.brand span{display:grid;place-items:center;width:24px;height:24px;border:1px solid var(--accent);border-radius:50%}.brand i{width:18px;border-top:1px solid var(--accent);border-radius:50%;transform:rotate(-12deg)}.music-nav nav{display:flex;gap:1.6rem;color:var(--muted);font-size:.68rem}.music-nav>div{display:flex;gap:.35rem}.music-nav button{width:36px;height:36px;border:1px solid var(--border);border-radius:6px;background:transparent;color:var(--text);cursor:pointer}
  .note-list a{transition:padding .25s var(--ease)}.note-list a:hover{padding-left:4px}
  .music-hero{position:relative;min-height:calc(100svh - 72px);display:grid;grid-template-columns:1fr 1fr;align-items:center;border-bottom:1px solid var(--border)}.music-hero>div:first-child{position:relative;z-index:2}.music-hero p,section header p{color:var(--accent-deep);font:.65rem var(--font-mono);letter-spacing:.14em}.music-hero h1{margin:2rem 0;color:var(--strong);font:500 clamp(4rem,8vw,8rem)/.92 var(--font-serif);letter-spacing:-.065em}.music-hero h1 em{color:var(--accent);font-style:normal}.music-hero>div>span{color:var(--muted);font:400 1rem var(--font-serif)}.music-hero>b{position:absolute;right:1rem;bottom:1rem;color:var(--muted);font:.55rem/1.5 var(--font-mono);letter-spacing:.12em}
  section{padding-block:clamp(6rem,10vw,10rem)}section header,.artists header{display:grid;grid-template-columns:80px 170px 1fr;align-items:end;padding-bottom:1.2rem;margin-bottom:4rem;border-bottom:1px solid var(--border)}section header>span,.artists header>span{color:var(--accent);font:.65rem var(--font-mono)}section header p,.artists header p{margin:0;color:var(--muted);font:.65rem var(--font-mono);letter-spacing:.1em}section header h2,.artists header h2{margin:0;color:var(--strong);font:500 clamp(2.3rem,5vw,5rem)/.9 var(--font-serif);letter-spacing:-.05em}
  .library-summary{display:grid;grid-template-columns:1fr 1fr auto;gap:2rem;align-items:end;margin-bottom:3rem}.library-summary small,.library-summary time{color:var(--accent);font:.62rem var(--font-mono);letter-spacing:.1em}.library-summary h3{margin:.65rem 0 0;color:var(--strong);font:500 clamp(2rem,4vw,4rem)/1 var(--font-serif)}.library-summary p{max-width:520px;margin:0;color:var(--muted);font:.85rem/1.8 var(--font-serif)}.library-summary time{white-space:nowrap;color:var(--muted)}
  .music-album-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(1.2rem,3vw,3rem)}.music-album-card{appearance:none;min-width:0;padding:0;border:0;background:transparent;color:inherit;text-align:left;cursor:pointer}.music-album-cover{position:relative;display:block;aspect-ratio:1;overflow:hidden;border:1px solid var(--border);background:var(--surface-2)}.music-album-cover img{width:100%;height:100%;object-fit:cover;transition:transform .48s var(--ease),filter .35s ease}.music-album-cover i{position:absolute;right:1rem;bottom:1rem;display:grid;place-items:center;width:48px;height:48px;border:1px solid rgb(255 255 255 / 55%);border-radius:50%;background:rgb(7 24 22 / 62%);color:#f1fffc;font-style:normal;opacity:0;transform:scale(.88);transition:opacity .25s ease,transform .3s var(--ease)}.music-album-card:hover .music-album-cover img,.music-album-card:focus-visible .music-album-cover img{transform:scale(1.025);filter:saturate(1.06)}.music-album-card:hover .music-album-cover i,.music-album-card:focus-visible .music-album-cover i{opacity:1;transform:scale(1)}.music-album-card:focus-visible{outline:1px solid var(--accent);outline-offset:7px}.music-album-meta{display:block;padding-top:1rem}.music-album-meta small,.music-album-meta em{display:block;color:var(--muted);font:.6rem var(--font-mono);letter-spacing:.08em}.music-album-meta strong{display:block;margin:.45rem 0;color:var(--strong);font:500 clamp(1.2rem,2vw,1.8rem)/1.25 var(--font-serif)}.music-album-meta em{font-style:normal}
  .listening-layout{display:grid;grid-template-columns:minmax(260px,.85fr) 1.15fr;gap:clamp(3rem,8vw,8rem);align-items:center}.record-art{position:relative;aspect-ratio:1;border:1px solid var(--border);background:linear-gradient(145deg,var(--surface-2),var(--surface));overflow:hidden}.record-art::before,.record-art::after{content:'';position:absolute;inset:14%;border:1px solid var(--accent);border-radius:50%;opacity:.5}.record-art::after{inset:43%;background:var(--bg);opacity:1}.record-art i{position:absolute;z-index:2;width:120%;height:1px;left:-10%;top:50%;background:var(--accent);transform:rotate(-17deg);box-shadow:0 28px 0 color-mix(in srgb,var(--accent) 25%,transparent),0 -28px 0 color-mix(in srgb,var(--accent) 15%,transparent)}.record-art span{position:absolute;z-index:3;left:1rem;bottom:1rem;color:var(--muted);font:.58rem/1.5 var(--font-mono);letter-spacing:.14em}.listening-layout article small{color:var(--accent);font:.65rem var(--font-mono)}.listening-layout h3{margin:.8rem 0 1.5rem;color:var(--strong);font:500 clamp(4rem,8vw,8rem)/.9 var(--font-serif);letter-spacing:-.06em}.listening-layout article>p{max-width:570px;color:var(--muted);font-family:var(--font-serif)}.tags{display:flex;flex-wrap:wrap;gap:.5rem;margin:2rem 0}.tags span{padding:.35rem .55rem;border:1px solid var(--border);border-radius:6px;color:var(--muted);font-size:.62rem}.listening-layout time{color:var(--muted);font:.6rem var(--font-mono)}
  .artists{background:#0a201d;color:#e8f3f1;padding:clamp(6rem,10vw,10rem) 0}.artists header{border-color:rgb(160 220 212 / 14%)}.artists header h2{color:#f3fbf9}.artists header p{color:#8faeaa}.artist-list{border-top:1px solid rgb(160 220 212 / 14%)}.artist-list article{display:grid;grid-template-columns:80px 1fr 1fr auto;gap:1.5rem;align-items:baseline;padding:2rem 0;border-bottom:1px solid rgb(160 220 212 / 14%)}.artist-list b{color:#64c7bd;font:.65rem var(--font-mono)}.artist-list h3{margin:0;font:500 clamp(2rem,4vw,4rem) var(--font-serif)}.artist-list p{color:#8faeaa;font-size:.78rem}.artist-list span{color:#96ddd5;font:.7rem var(--font-mono)}.artist-list .placeholder{opacity:.56}
  .archive-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(3rem,8vw,8rem)}.archive-intro p{max-width:300px;color:var(--muted)}.archive-intro strong{display:block;margin-top:4rem;color:var(--accent);font:500 clamp(3rem,6vw,6rem)/.85 var(--font-serif)}.archive-rows{border-top:1px solid var(--border)}.archive-rows article{padding:1.8rem 0;border-bottom:1px solid var(--border)}.archive-rows span{color:var(--accent);font:.6rem var(--font-mono)}.archive-rows h3{margin:.6rem 0;font:500 1.7rem var(--font-serif)}.archive-rows p{margin:0;color:var(--muted);font-size:.78rem}
  .note-list{border-top:1px solid var(--border)}.note-list a{position:relative;display:block;padding:2rem 3rem 2rem 0;border-bottom:1px solid var(--border)}.note-list small{color:var(--accent);font:.62rem var(--font-mono)}.note-list h3{font:500 1.8rem var(--font-serif)}.note-list p{max-width:650px;color:var(--muted);font-size:.8rem}.note-list a>span{position:absolute;right:0;top:50%;color:var(--accent)}.empty-notes{padding:4rem 0;border-block:1px solid var(--border)}.empty-notes strong{font:500 1.8rem var(--font-serif)}.empty-notes p{color:var(--muted)}
  .music-future{background:var(--surface-2)}.future-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--border)}.future-grid article{padding:2rem 2rem 2rem 0;border-right:1px solid var(--border)}.future-grid article+article{padding-left:2rem}.future-grid article:last-child{border-right:0}.future-grid span{color:var(--accent);font:.6rem var(--font-mono)}.future-grid h3{font:500 1.8rem var(--font-serif)}.future-grid p{color:var(--muted);font-size:.75rem}
  footer{padding-bottom:8rem;border-top:1px solid var(--border)}footer>.container{padding-top:3rem}footer strong{font:500 clamp(2.5rem,5vw,5rem) var(--font-serif);color:var(--accent-deep)}footer p,footer a{color:var(--muted);font-size:.75rem}footer a{display:inline-block;margin-top:1rem;color:var(--accent)}
  @media(max-height:800px){.music-hero{min-height:0;padding-block:4.5rem}}
  @media(max-width:900px){.library-summary{grid-template-columns:1fr 1fr}.library-summary time{grid-column:2}.music-album-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:800px){.music-nav nav{display:none}.music-hero{grid-template-columns:1fr}.listening-layout,.archive-layout{grid-template-columns:1fr}.artist-list article{grid-template-columns:42px 1fr}.artist-list p,.artist-list span{grid-column:2}.future-grid{grid-template-columns:1fr}.future-grid article,.future-grid article+article{padding:1.5rem 0;border-right:0;border-bottom:1px solid var(--border)}}
  @media(max-width:560px){section header,.artists header{grid-template-columns:1fr;gap:.7rem}.music-hero h1{font-size:clamp(3.6rem,17vw,5.4rem)}.library-summary{grid-template-columns:1fr}.library-summary time{grid-column:auto}.music-album-grid{grid-template-columns:1fr}.music-album-cover i{opacity:1;transform:scale(1)}}
  @media(prefers-reduced-motion:reduce){.music-album-cover img,.music-album-cover i{transition:none}}
</style>
