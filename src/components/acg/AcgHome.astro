---
import type { CollectionEntry } from 'astro:content';
import MotionBlock from '../common/MotionBlock.astro';
import WindWaveMotif from './WindWaveMotif.astro';
import { albumStartIndexes, musicAlbums } from '../../data/music';

interface Props {
  posts: CollectionEntry<'blog'>[];
  projects: CollectionEntry<'projects'>[];
  notes: CollectionEntry<'notes'>[];
  prototype?: boolean;
}

const { posts, projects, prototype = true } = Astro.props;
const musicHref = prototype ? '/prototype/acg/music/' : '/music/';
const watching = [
  { title: '葬送のフリーレン', meta: 'Frieren', progress: 82, status: 'Watching', image: '/media/anime/frieren.webp', source: 'https://frieren-anime.jp/special/gallery/' },
  { title: 'ぼっち・ざ・ろっく！', meta: 'Bocchi the Rock!', progress: 100, status: 'Finished', image: '/media/anime/bocchi-the-rock.webp', source: 'https://bocchi.rocks/tv/' },
  { title: '86 —Eighty Six—', meta: 'Anime note', progress: 64, status: 'Watching', image: '/media/anime/eighty-six.webp', source: 'https://anime-86.com/' },
];
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', { month: '2-digit', day: '2-digit' }).format(date);
---

<main class="acg-home" data-acg-root>
<MotionBlock enabled={!prototype} follow="motif">  <section class="home-scene threshold-scene" data-scene="threshold" id="top" aria-labelledby="hero-title">
    <div class="scene-track">
      <div class="scene-pin">
        <div class="scene-stage acg-hero container">
          <div class="hero-copy">
            <div class="hero-kicker-slot">
              <p class="season hero-kicker hero-kicker-season"><span data-environment-season>夏 / SUMMER</span><b>· 2026</b></p>
              <p class="season hero-kicker hero-kicker-threshold"><span>00</span><b>/ THRESHOLD</b></p>
            </div>
            <h1 id="hero-title">写到天亮，<br /><em>也没关系。</em></h1>
            <div class="hero-sub-slot" aria-live="off">
              <p class="hero-sub hero-beat hero-beat-one">写作、代码、音乐，和一点夏天的碎片。</p>
              <p class="hero-sub hero-beat hero-beat-two">先把房间打开。</p>
              <p class="hero-sub hero-beat hero-beat-three">往下走。最近的四件事会自己站出来。</p>
            </div>
            <div class="identity"><strong>nabunana</strong><span>Developer</span><span>Writer</span><span>Music Listener</span></div>
            <div class="actions">
              <a class="acg-button" href="#writing">读一些文字 <span>↗</span></a>
              <a class="text-link" href="#currently">从这里开始 <span>↓</span></a>
            </div>
          </div>
          <WindWaveMotif />
        </div>
      </div>
    </div>
  </section></MotionBlock>

  <section class="home-scene currently-scene" data-scene="currently" id="currently" aria-labelledby="currently-title">
    <div class="scene-track">
      <div class="scene-pin">
        <div class="scene-stage scene-chapter container">
          <header class="section-head scene-heading">
            <p><span>01</span> 最近のこと</p>
            <h2 id="currently-title">NOW</h2>
            <small>同一时间里，只把一件事放亮。</small>
          </header>
          <div class="currently-stage">
            <div class="currently-focus" aria-live="polite">
              <article style="--i:0">
                <small>01 / 今聴いている</small>
                <strong>Yorushika</strong>
                <p>最近的音乐片段，没有伪装成播放器。</p>
              </article>
              <article style="--i:1">
                <small>02 / 今見ている</small>
                <strong>葬送のフリーレン</strong>
                <p>把旅途、时间和告别慢慢看完。</p>
              </article>
              <article style="--i:2">
                <small>03 / 制作中</small>
                <strong>Personal Blog</strong>
                <p>Astro、内容系统与属于自己的视觉语言。</p>
              </article>
              <article style="--i:3">
                <small>04 / 読んでいる</small>
                <strong>技术文章与随笔</strong>
                <p>在工程实践之外，留一点给文字。</p>
              </article>
            </div>
            <ul class="currently-index" aria-hidden="true">
              <li style="--i:0"><span>01</span>今聴いている · Yorushika</li>
              <li style="--i:1"><span>02</span>今見ている · 葬送のフリーレン</li>
              <li style="--i:2"><span>03</span>制作中 · Personal Blog</li>
              <li style="--i:3"><span>04</span>読んでいる · 技术文章与随笔</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="writing container editorial-depth" data-editorial-depth data-reveal-group id="writing" aria-labelledby="writing-title">
<MotionBlock enabled={!prototype}>    <header class="section-head" data-scroll-reveal><p><span>02</span> 文章</p><h2 id="writing-title">LATEST WRITING</h2><a href="/blog/">全部文章 ↗</a></header></MotionBlock>
    <div class="editorial-list">
      {posts.slice(0, 5).map((post) => (
<MotionBlock enabled={!prototype} hover="row">        <a href={`/blog/${post.id}/`} data-scroll-reveal>
          <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>
          <small>{post.data.category}</small>
          <div><h3><span data-motion-title>{post.data.title}</span></h3><p>{post.data.description}</p></div>
          <span aria-hidden="true" data-motion-arrow>↗</span>
        </a></MotionBlock>
      ))}
    </div>
  </section>

<MotionBlock enabled={!prototype}>  <section class="music home-scene music-scene" data-scene="music" id="music" aria-labelledby="music-title">
    <div class="scene-track">
      <div class="scene-pin">
        <div class="scene-stage music-stage">
          <div class="container music-shell">
            <header class="section-head inverse scene-heading"><p><span>03</span> 音楽</p><h2 id="music-title">AFTER DARK</h2><div class="scene-heading-meta"><small>封面随滚动换气。点下去，从第一首开始。</small><a href={musicHref}>进入音乐页 ↗</a></div></header>
            <div class="album-gallery" aria-label="七张专辑唱片廊" aria-roledescription="carousel" data-album-carousel>
              {musicAlbums.map((album, index) => (
                <button type="button" class="album-card" style={`--i:${index}`} data-album-index={index} data-play-index={albumStartIndexes[album.slug]} aria-label={`播放专辑 ${album.title}`} tabindex={index === 0 ? 0 : -1}>
                  <span class="album-cover"><img src={album.cover} alt={`${album.title} 专辑封面`} loading={index === 0 ? 'eager' : 'lazy'} /><i aria-hidden="true"></i><b aria-hidden="true">▶</b></span>
                  <span class="album-number">{String(index + 1).padStart(2, '0')} / {album.year}</span>
                  <strong>{album.title}</strong>
                  <small>{album.artist} · {album.tracks.length} TRACKS</small>
                </button>
              ))}
              <span class="carousel-status" data-carousel-status aria-live="polite">当前专辑：{musicAlbums[0].title}</span>
            </div>
            <p class="gallery-note"><span>SCROLL TO BROWSE</span> 拖动或方向键对齐封面。点击从第一首开始。</p>
          </div>
        </div>
      </div>
    </div>
  </section></MotionBlock>

  <section class="projects container editorial-depth" data-editorial-depth data-reveal-group id="projects" aria-labelledby="projects-title">
<MotionBlock enabled={!prototype}>    <header class="section-head" data-scroll-reveal><p><span>03</span> 作品</p><h2 id="projects-title">PROJECTS</h2><a href="/projects/">项目归档 ↗</a></header></MotionBlock>
    <div class="project-list">
      {projects.map((project, index) => <MotionBlock enabled={!prototype} hover="project" follow="surface"><article data-scroll-reveal><span>{String(index + 1).padStart(2, '0')}</span><div><small>{project.data.tech.slice(0, 3).join(' / ')}</small><h3><span data-motion-title>{project.data.name}</span></h3><p>{project.data.description}</p></div><b>{project.data.status}</b></article></MotionBlock>)}
    </div>
  </section>

  <section class="home-scene watching-scene" data-scene="watching" id="watching" aria-labelledby="watching-title">
    <div class="scene-track">
      <div class="scene-pin">
        <div class="scene-stage scene-chapter container">
<MotionBlock enabled={!prototype}>          <header class="section-head scene-heading"><p><span>06</span> 今見ている</p><h2 id="watching-title">WATCHING</h2><small>一次只看一张。</small></header></MotionBlock>
          <div class="watching-grid">
            {watching.map((item, index) => <MotionBlock enabled={!prototype} hover="media" follow="media"><article style={`--i:${index}`}><a class="watch-cover" href={item.source} target="_blank" rel="noopener" aria-label={`${item.title} 官方视觉图来源`}><img data-motion-media src={item.image} alt={`${item.title} 官方宣传视觉图`} width="900" height="1200" loading="lazy" /><span>{String(index + 1).padStart(2, '0')}</span><i>OFFICIAL ↗</i></a><small>{item.meta}</small><h3>{item.title}</h3><div class="watch-progress"><i style={`width:${item.progress}%`}></i></div><footer><span>{item.progress}%</span><b>{item.status}</b></footer></article></MotionBlock>)}
          </div>
        </div>
      </div>
    </div>
  </section>

<MotionBlock enabled={!prototype}>  <section class="fragments editorial-depth" data-editorial-depth id="fragments" aria-labelledby="fragments-title">
    <div class="container"><header class="section-head inverse"><p><span>05</span> 残像</p><h2 id="fragments-title">FRAGMENTS</h2></header><div class="fragment-grid" aria-label="项目截图、听歌记录和动画清单占位"><div><span>PROJECT / SCREENSHOT</span></div><div><span>MUSIC / LISTENING</span></div><div><span>ANIME / WATCHLIST</span></div></div><p class="fragment-note">先留三个位置：以后放项目截图、听歌记录和看过的动画。</p></div>
  </section></MotionBlock>

  <section class="about container" data-reveal-group data-reveal-stagger="lines" id="about">
<MotionBlock enabled={!prototype}>    <p class="about-kicker" data-scroll-reveal>06 / ABOUT THIS PLACE</p></MotionBlock>
<MotionBlock enabled={!prototype}>    <h2 data-scroll-reveal>你所热爱的，就是你的生活</h2></MotionBlock>
<MotionBlock enabled={!prototype}>    <p class="about-copy">
      <span data-scroll-reveal>我是 nabunana，学的软件工程，最近在找工作。</span>
      <span data-scroll-reveal>这个网站会以软件开发和技术记录为主，也会放自己喜欢的音乐、看过的动画，以及偶尔读到的小说。</span>
      <span data-scroll-reveal>希望来这里的同好既能找到有用的内容，也能因为熟悉的音乐或动画开心一点。</span>
    </p></MotionBlock>
<MotionBlock enabled={!prototype}>    <a class="text-link" href="/about/" data-scroll-reveal>关于我与这个网站 <span>↗</span></a></MotionBlock>
  </section>

<MotionBlock enabled={!prototype}>  <footer class="acg-footer" data-reveal-group data-reveal-stagger="lines"><WindWaveMotif compact label="Footer sea horizon" /><div class="container footer-copy"><div><strong data-scroll-reveal>また、どこかで。</strong><p data-scroll-reveal>有空再来看看。</p></div><div><span data-scroll-reveal>nabunana © 2026</span><nav aria-label="页脚导航" data-scroll-reveal><a href="/blog/">Writing</a><a href="/music/">Music</a><a href="/projects/">Projects</a><a href="https://github.com/1753262762" target="_blank" rel="me noopener">GitHub</a><a href="/rss.xml">RSS</a></nav></div></div></footer></MotionBlock>

</main>

<script>
  import { initHomeScroll, scrollSceneTo } from '../../lib/home-scroll';

  let acgHomeAbort: AbortController | undefined;
  const bindAcgHome = () => {
    acgHomeAbort?.abort();
    acgHomeAbort = new AbortController();
    const { signal } = acgHomeAbort;
    const root = document.querySelector<HTMLElement>('[data-acg-root]');
    if (!root) return;
    initHomeScroll({ root, signal });
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const clamp = (value: number) => Math.min(1, Math.max(0, value));
    const musicScene = document.querySelector<HTMLElement>('[data-scene="music"]');
    const albumRail = document.querySelector<HTMLElement>('[data-album-carousel]');
    if (albumRail && musicScene) {
      const cards = [...albumRail.querySelectorAll<HTMLButtonElement>('[data-album-index]')];
      const status = albumRail.querySelector<HTMLElement>('[data-carousel-status]');
      const lastIndex = Math.max(cards.length - 1, 1);
      let dragging = false;
      let dragged = false;
      let suppressClick = false;
      let pointerStart = 0;
      let startScrollY = 0;
      let announcedIndex = -1;

      const announce = (index: number) => {
        const next = Math.max(0, Math.min(cards.length - 1, index));
        if (next === announcedIndex) return;
        announcedIndex = next;
        cards.forEach((card, cardIndex) => {
          card.tabIndex = cardIndex === next ? 0 : -1;
          if (cardIndex === next) card.setAttribute('aria-current', 'true');
          else card.removeAttribute('aria-current');
          card.style.pointerEvents = Math.abs(cardIndex - next) <= 1.2 ? 'auto' : 'none';
        });
        if (status) status.textContent = `当前专辑：${cards[next]?.querySelector('strong')?.textContent || ''}`;
      };

      const getCurrentP = () => {
        return clamp(Number.parseFloat(musicScene.style.getPropertyValue('--p') || '0') || 0);
      };

      musicScene.addEventListener('scene-progress', (event: any) => {
        const p = event.detail?.p ?? getCurrentP();
        announce(Math.round(p * lastIndex));
      }, { signal });

      announce(Math.round(getCurrentP() * lastIndex));

      albumRail.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        dragging = true;
        dragged = false;
        pointerStart = event.clientX;
        startScrollY = window.scrollY;
        albumRail.classList.add('is-dragging');
        albumRail.setPointerCapture(event.pointerId);
        if (event.target instanceof Element && event.target.closest('img')) event.preventDefault();
      }, { signal });

      albumRail.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const dx = event.clientX - pointerStart;
        if (Math.abs(dx) > 5) dragged = true;
        if (!dragged) return;
        const track = musicScene.querySelector<HTMLElement>('.scene-track') || musicScene;
        const scrollable = track.offsetHeight - window.innerHeight;
        const cardWidth = cards[0]?.getBoundingClientRect().width || 280;
        const stride = Math.min(cardWidth * 0.88, albumRail.clientWidth * 0.34);
        const deltaP = -dx / (stride * lastIndex);
        window.scrollTo({
          top: startScrollY + deltaP * scrollable,
          behavior: 'auto',
        });
      }, { signal });

      const finishDrag = (event: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        albumRail.classList.remove('is-dragging');
        if (albumRail.hasPointerCapture(event.pointerId)) albumRail.releasePointerCapture(event.pointerId);
        if (!dragged) return;
        suppressClick = true;
        const p = getCurrentP();
        const targetIndex = Math.round(p * lastIndex);
        scrollSceneTo(musicScene, targetIndex / lastIndex, true);
      };

      albumRail.addEventListener('pointerup', finishDrag, { signal });
      albumRail.addEventListener('pointercancel', finishDrag, { signal });

      albumRail.addEventListener('click', (event) => {
        if (suppressClick) {
          event.preventDefault();
          event.stopPropagation();
          suppressClick = false;
          return;
        }
        const card = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-album-index]') : null;
        if (!card) return;
        const index = Number.parseInt(card.dataset.albumIndex || '0', 10);
        if (Number.isFinite(index)) {
          scrollSceneTo(musicScene, index / lastIndex, true);
        }
      }, { capture: true, signal });

      albumRail.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const direction = event.key === 'ArrowRight' ? 1 : -1;
        const p = getCurrentP();
        const currentIndex = Math.round(p * lastIndex);
        const targetIndex = Math.max(0, Math.min(cards.length - 1, currentIndex + direction));
        scrollSceneTo(musicScene, targetIndex / lastIndex, true);
        cards[targetIndex]?.focus({ preventScroll: true });
      }, { signal });
    }
    reducedMotion.addEventListener('change', bindAcgHome, { signal });
    document.querySelectorAll<HTMLButtonElement>('[data-play-index]').forEach((button) => button.addEventListener('click', () => {
      const index = Number.parseInt(button.dataset.playIndex || '0', 10);
      window.dispatchEvent(new CustomEvent('nabunana:play-track', { detail: index }));
    }, { signal }));
    if (!document.body.classList.contains('formal-site') && matchMedia('(pointer:fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const art = document.querySelector<HTMLElement>('.acg-hero .wind-wave');
      document.querySelector('.acg-hero')?.addEventListener('pointermove', (event) => {
        if (!(event instanceof PointerEvent) || !art) return;
        const scene = art.closest<HTMLElement>('[data-scene="threshold"]');
        if (Number.parseFloat(scene?.style.getPropertyValue('--p') || '0') >= .25) {
          art.style.setProperty('--hero-pointer-x', '0px');
          art.style.setProperty('--hero-pointer-y', '0px');
          return;
        }
        const bounds = (event.currentTarget as HTMLElement).getBoundingClientRect();
        const x = ((event.clientX - bounds.left) / bounds.width - .5) * 6;
        const y = ((event.clientY - bounds.top) / bounds.height - .5) * 4;
        art.style.setProperty('--hero-pointer-x', `${x}px`);
        art.style.setProperty('--hero-pointer-y', `${y}px`);
      }, { signal });
    }
  };
  document.addEventListener('astro:page-load', bindAcgHome);
  bindAcgHome();
</script>

<style>
  :global(.prototype-acg), :global(.acg-site) { --bg:#f5fbfa;--surface:#fff;--surface-2:#edf7f5;--text:#173b3a;--strong:#102e2d;--muted:#64817f;--accent:#3dafa5;--accent-soft:#68c5bb;--accent-deep:#216e69;--sky:#83c9d7;--border:rgb(39 108 103 / 14%);background:var(--bg);color:var(--text); }
  :global(:root[data-theme='dark'] .prototype-acg), :global(:root[data-theme='dark'] .acg-site) { --bg:#102724;--surface:#18332f;--surface-2:#1e3b36;--text:#e7f0ed;--strong:#f3f8f6;--muted:#9eb3ae;--accent:#78c5bb;--accent-soft:#a0ddd5;--accent-deep:#58aaa0;--sky:#72aeb3;--border:rgb(174 222 215 / 15%); }
  @property --p{syntax:'<number>';inherits:true;initial-value:0}
  .acg-home{overflow:visible;background:transparent;color:var(--text);transition:color .35s ease}
  .acg-home::before{content:'';position:fixed;z-index:20;inset:0;pointer-events:none;opacity:.018;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 140 140' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")}
  .home-scene{--p:0;position:relative}.scene-track{position:relative}.scene-pin{position:sticky;z-index:1;top:0;min-height:100svh;height:auto;box-sizing:border-box;padding-bottom:80px;overflow:visible}.scene-stage{min-height:calc(100svh - 80px);height:auto;box-sizing:border-box}.scene-chapter{padding-top:clamp(2rem,6vh,5rem)}.scene-heading>small,.scene-heading-meta small{display:block;max-width:260px;color:var(--muted);font:400 .78rem/1.5 var(--font-serif);text-align:right}.scene-heading-meta{text-align:right}.scene-heading-meta a{display:inline-block;margin-top:.45rem;color:var(--muted);font-size:.68rem}
  .threshold-scene .scene-track{height:240vh}.acg-hero{position:relative;display:grid;grid-template-columns:1fr 1fr;align-items:stretch;border-bottom:1px solid var(--border)}.hero-copy{align-self:center;padding:clamp(3.5rem,7vh,6rem) clamp(2rem,6vw,6rem) clamp(3.5rem,7vh,7rem) 0}.hero-kicker-slot{position:relative;height:1rem;margin-bottom:4rem}.season{display:flex;width:max-content;gap:1rem;margin:0;color:var(--muted);font:.68rem var(--font-mono);letter-spacing:.16em}.season span{color:var(--accent-deep)}.season b{font-weight:500}.hero-kicker{position:absolute;inset:0 auto auto 0}.hero-kicker-season{opacity:clamp(0,calc((.34 - var(--p))*8.333),1)}.hero-kicker-threshold{opacity:clamp(0,calc((var(--p) - .22)*8.333),1)}
  h1{margin:0;color:var(--strong);font:500 clamp(3.8rem,min(7.6vw,10vh),8.2rem)/.98 var(--font-serif);letter-spacing:-.065em}.hero-copy h1{opacity:clamp(.12,calc(1 - max(0,var(--p) - .82)*4.888),1);transform:translateY(calc(max(0,var(--p) - .82)*-177.778px))}.hero-copy h1 em{color:var(--accent);font-style:normal}.hero-sub-slot{position:relative;height:4.2rem;margin:2.5rem 0}.hero-sub{position:absolute;inset:0;margin:0;color:var(--muted);font:400 clamp(1rem,1.6vw,1.25rem)/1.65 var(--font-serif);letter-spacing:.01em}.hero-beat-one{opacity:clamp(0,calc((.34 - var(--p))*8.333),1)}.hero-beat-two{opacity:clamp(0,min(calc((var(--p) - .22)*8.333),calc((.67 - var(--p))*8.333)),1)}.hero-beat-three{opacity:clamp(0,calc((var(--p) - .55)*8.333),1)}.identity{display:flex;flex-wrap:wrap;gap:.55rem 1.1rem;align-items:center;margin:2.5rem 0;color:var(--muted);font-size:.72rem;opacity:clamp(0,calc((.62 - var(--p))*8.333),1)}.identity strong{color:var(--text);font:600 1.1rem var(--font-serif);padding-right:1.1rem;border-right:1px solid var(--border)}
