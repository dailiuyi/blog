---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/common/SiteHeader.astro';
import MotionBlock from '../../components/common/MotionBlock.astro';
import PageHero from '../../components/common/PageHero.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf());
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', { year:'numeric', month:'2-digit', day:'2-digit' }).format(date);
---
<BaseLayout title="文章 · nabunana" description="工程复盘、学习笔记、ACG 与生活记录。" pageClass="acg-site" lightingRegister="grove">
  <SiteHeader current="writing" />
  <PageHero eyebrow="文章 / WRITING" title={'把做过的事，\n慢慢写清楚。'} description="工程复盘、学习笔记与兴趣记录。这里只保留仍然值得阅读和继续维护的内容。" count={`${posts.length} ENTRIES`} />
  <main class="writing-page container" data-editorial-depth data-reveal-group>
<MotionBlock >    <div class="writing-tools" data-scroll-reveal><p>記憶 / ARCHIVE</p><button type="button" data-search-open>搜索文章 <span>⌘K</span></button></div></MotionBlock>
    <section class="writing-list" aria-label="文章列表">
      {posts.map((post, index) => <MotionBlock hover="row"><a href={`/blog/${post.id}/`} data-scroll-reveal><span class="index">{String(index + 1).padStart(2,'0')}</span><div class="meta"><time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time><small>{post.data.category}</small></div><div><h2><span data-motion-title>{post.data.title}</span></h2><p>{post.data.description}</p><footer>{post.data.tags.slice(0,4).map((tag)=><span>#{tag}</span>)}</footer></div><b>{post.data.readingTime}<i data-motion-arrow>↗</i></b></a></MotionBlock>)}
    </section>
  </main>
<MotionBlock >  <footer class="page-footer"><div class="container"><strong>文章会留下，过时的内容不会占据首页。</strong><a href="/rss.xml">RSS 订阅 ↗</a></div></footer></MotionBlock>
</BaseLayout>
<style>
  .writing-page{padding:clamp(5rem,9vw,9rem) 0}.writing-tools{display:flex;justify-content:space-between;align-items:center;margin-bottom:2.5rem}.writing-tools p{color:var(--accent-deep);font:.65rem var(--font-mono);letter-spacing:.12em}.writing-tools button{padding:.65rem .8rem;border:1px solid var(--border);border-radius:6px;background:transparent;color:var(--text);font-size:.7rem;cursor:pointer}.writing-tools button span{margin-left:.5rem;color:var(--muted);font:inherit}.writing-list{border-top:1px solid var(--border)}.writing-list a{display:grid;grid-template-columns:54px 145px 1fr 86px;gap:1.5rem;align-items:start;padding:2rem 0;border-bottom:1px solid var(--border);transition:padding .25s var(--ease)}.writing-list a:hover{padding-left:4px}.index{color:var(--accent);font:.65rem var(--font-mono)}.meta{display:grid;gap:.5rem;color:var(--muted);font:.62rem var(--font-mono)}.meta small{color:var(--accent-deep);text-transform:uppercase}.writing-list h2{margin:-.35rem 0 .6rem;color:var(--strong);font:500 clamp(1.4rem,2.4vw,2.3rem)/1.2 var(--font-serif);letter-spacing:-.025em}.writing-list p{max-width:660px;margin:0;color:var(--muted);font-size:.82rem}.writing-list footer{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.2rem;color:var(--muted);font-size:.62rem}.writing-list a>b{display:flex;justify-content:space-between;color:var(--muted);font:500 .62rem var(--font-mono)}.writing-list a>b i{color:var(--accent);font-style:normal;opacity:0;transition:opacity .2s,transform .2s}.writing-list a:hover>b i{opacity:1;transform:translateX(3px)}.page-footer{padding:5rem 0 8rem;background:#0a201d;color:#e8f3f1}.page-footer>div{display:flex;justify-content:space-between;align-items:end;gap:2rem}.page-footer strong{max-width:650px;font:500 clamp(2rem,4vw,4rem)/1.05 var(--font-serif)}.page-footer a{color:#96ddd5;font-size:.72rem}
  @media(max-width:800px){.writing-list a{grid-template-columns:40px 1fr 24px}.meta{grid-column:2}.writing-list a>div:nth-child(3){grid-column:2}.writing-list a>b{grid-column:3;grid-row:1/4}.writing-list a>b{font-size:0}.writing-list a>b i{font-size:.8rem;opacity:1}.page-footer>div{align-items:flex-start;flex-direction:column}}
  @media(max-width:430px){.writing-tools button span{display:none}.writing-list a{gap:1rem}}
</style>
