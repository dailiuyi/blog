---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/common/SiteHeader.astro';
import PageHero from '../../components/common/PageHero.astro';
import { buildSeriesIndex, buildSeriesMembershipMap } from '../../lib/series';
const posts = (await getCollection('blog', ({data})=>!data.draft)).sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf());
const categories = [...new Set(posts.map(post=>post.data.category))];
const seriesByPost = buildSeriesMembershipMap(buildSeriesIndex(posts));
// 列表页的结构化数据：Blog + ItemList，便于搜索引擎理解文章集合。
const listSchema = {"@context":"https://schema.org","@type":"CollectionPage",name:'文章 · nabunana',description:'工程复盘、学习笔记、ACG 与生活记录。',url:new URL('/blog/',Astro.site).href,inLanguage:'zh-CN',isPartOf:{"@type":"Blog",name:"nabunana's Blog",url:new URL('/',Astro.site).href},mainEntity:{"@type":"ItemList",numberOfItems:posts.length,itemListElement:posts.map((post,index)=>({"@type":"ListItem",position:index+1,name:post.data.title,url:new URL(`/blog/${post.id}/`,Astro.site).href}))}};
---
<BaseLayout title="文章 · nabunana" description="工程复盘、学习笔记、ACG 与生活记录。" pageClass="acg-site" lightingRegister="quiet">
  <SiteHeader current="writing" /><PageHero eyebrow="文章 / WRITING" title="把做过的事，慢慢写清楚。" description="平时做项目踩过的坑、工具的使用体会，以及一些日常随笔。" count={`${posts.length} ENTRIES`} />
  <main id="main" class="writing-page container"><div class="writing-toolbar"><div class="category-filters" role="group" aria-label="按主题筛选文章"><button type="button" data-category="all" aria-pressed="true">全部</button>{categories.map(category=><button type="button" data-category={category} aria-pressed="false">{category}</button>)}</div><button type="button" class="archive-search" data-search-open>搜索文章 ↗</button></div><p class="sr-only" data-filter-count aria-live="polite">共 {posts.length} 篇文章</p><div class="article-list">{posts.map(post=>{const series=seriesByPost.get(post.id);return <article data-post-category={post.data.category}><div class="entry-meta"><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString('zh-CN')}</time><span>{post.data.category}</span>{series && <a class="series-badge" href={`/series/${series.slug}/`}>{series.name} · 第 {series.position}/{series.total} 篇</a>}</div><a href={`/blog/${post.id}/`}><h2>{post.data.title}</h2><p>{post.data.description}</p><div class="entry-bottom"><span>{post.data.tags.slice(0,3).join(' / ')}</span><span>{post.data.readingTime} ↗</span></div></a></article>})}</div><a class="rss-link" href="/rss.xml">通过 RSS 订阅新文章 ↗</a></main>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(listSchema)} />
</BaseLayout>
<script>
  let filterAbort: AbortController | undefined;
  function bindFilters(){
    filterAbort?.abort(); filterAbort=new AbortController();
    const { signal } = filterAbort;
    const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-category]')];
    const articles=[...document.querySelectorAll<HTMLElement>('[data-post-category]')];
    buttons.forEach(button=>button.addEventListener('click',()=>{
      const selected=button.dataset.category;
      buttons.forEach(item=>item.setAttribute('aria-pressed',String(item===button)));
      articles.forEach(article=>article.hidden=selected!=='all'&&article.dataset.postCategory!==selected);
      const count=document.querySelector('[data-filter-count]');
      if(count) count.textContent=`共 ${articles.filter(article=>!article.hidden).length} 篇文章`;
    },{signal}));
  }
  document.addEventListener('astro:page-load',bindFilters);bindFilters();
</script>
<style>
  .writing-page{padding-block:30px 64px}.writing-toolbar{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px}.category-filters{display:flex;flex-wrap:wrap;gap:8px}button{border:1px solid var(--border);background:transparent;color:var(--muted);border-radius:6px;padding:9px 12px;min-height:40px;font-size:12px;cursor:pointer;transition:background .2s,color .2s}button[aria-pressed='true']{background:var(--text);color:var(--bg);border-color:var(--text)}.archive-search{flex-shrink:0;border:0;color:var(--accent-deep);cursor:pointer}.article-list article{display:grid;grid-template-columns:150px minmax(0,1fr);gap:40px;padding:32px 16px;border-top:1px solid var(--border);border-radius:8px;transition:background .25s ease,transform .25s var(--ease)}.article-list article:hover{background:color-mix(in srgb,var(--surface-2) 65%,transparent);transform:translateX(4px)}.article-list article[hidden]{display:none}.entry-meta{display:grid;align-content:start;gap:10px;color:var(--muted);font:11px/1.6 var(--font-mono);padding-top:6px}.entry-meta span{display:inline-flex;width:fit-content;padding:2px 7px;border-radius:4px;background:color-mix(in srgb,var(--accent) 12%,transparent);color:var(--accent-deep);font-size:10px}h2{font:500 23px/1.5 var(--font-sans);letter-spacing:-.025em;margin:0 0 12px}.article-list p{font-size:14px;line-height:1.9;color:var(--muted);max-width:760px;margin:0}.entry-bottom{display:flex;justify-content:space-between;gap:20px;margin-top:20px;font:10px/1.7 var(--font-mono);color:var(--muted)}a:hover h2{text-decoration:underline;text-underline-offset:5px}.rss-link{display:inline-block;margin-top:25px;font-size:13px;color:var(--accent-deep)}@media(max-width:650px){.writing-toolbar{align-items:start;flex-direction:column;gap:8px}.archive-search{padding-left:0}.article-list article{grid-template-columns:1fr;gap:12px;padding:24px 0}.article-list article:hover{background:transparent;transform:none}.entry-meta{display:flex;gap:20px}h2{font-size:20px}.article-list p{font-size:13px}.entry-bottom{flex-wrap:wrap}}
  .series-badge{display:inline-flex;width:max-content;max-width:100%;align-items:center;gap:6px;padding:3px 8px;border:1px solid var(--border);border-radius:999px;color:var(--accent-deep);font:10px/1.4 var(--font-mono);letter-spacing:.03em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.series-badge:hover{border-color:var(--accent-deep)}
  @media(prefers-reduced-motion:reduce){.article-list article{transition:none}}
</style>
