---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/common/SiteHeader.astro';
import PageHero from '../components/common/PageHero.astro';
import ProjectShowcase from '../components/common/ProjectShowcase.astro';
import { projectPageProjects } from '../data/selected-projects';
const showcaseNames = new Set<string>(projectPageProjects.map(p => p.name));
const extraProjects = (await getCollection('projects')).filter(p => !showcaseNames.has(p.data.name));
const totalProjects = projectPageProjects.length + extraProjects.length;
---
<BaseLayout title="作品 · nabunana" description="做过的一些个人项目与小工具，附真实预览、源码和构建记录。" pageClass="acg-site" lightingRegister="quiet">
  <SiteHeader current="projects" /><PageHero eyebrow="作品 / PROJECTS" title="自己写的一些东西。" description="平时遇到问题时写的小工具，以及为了弄懂底层细节折腾的实验项目。" count={`${totalProjects} PROJECTS`} />
  <main id="main" class="projects-page container"><h2 class="sr-only">精选作品</h2><ProjectShowcase projects={projectPageProjects} /><section class="other-projects"><h2>其他一些小工具</h2>{extraProjects.map(project => <div class="other-project"><a class="other-project-main" href={project.data.article ?? '/projects/'}><div><h3>{project.data.name}</h3><p>{project.data.description}</p><small>{project.data.tech.join(' / ')}</small></div><span aria-hidden="true">↗</span></a>{project.data.repo && <a class="other-project-repo" href={project.data.repo} target="_blank" rel="noopener noreferrer">源码 ↗</a>}</div>)}</section></main>
</BaseLayout>
<style>.projects-page{padding-block:40px 64px}.other-projects{margin-top:56px}.other-projects h2{font-size:25px;font-weight:500;margin-bottom:25px}.other-projects>.other-project{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:25px 0;border-top:1px solid var(--border)}.other-projects>.other-project>.other-project-main{display:flex;flex:1;align-items:center;justify-content:space-between;gap:24px}h3{font-size:20px;font-weight:500;margin:0 0 10px}p{font-size:14px;line-height:1.8;color:var(--muted)}small{font:11px var(--font-mono);color:var(--muted)}.other-projects>.other-project>.other-project-main>span{color:var(--accent-deep)}.other-projects>.other-project>.other-project-repo{flex:none;font:11px var(--font-mono);color:var(--muted);border:1px solid var(--border);padding:5px 10px}.other-projects a:hover h3{text-decoration:underline;text-underline-offset:5px}</style>
