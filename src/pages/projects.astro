---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/common/SiteHeader.astro';
import MotionBlock from '../components/common/MotionBlock.astro';
import PageHero from '../components/common/PageHero.astro';
const projects=await getCollection('projects');
const articleByProject: Record<string,string> = {
  'Three Body Lab': '/blog/threebody-realtime-pipeline/',
  'Chat Digest Agent': '/blog/chat-digest-resilience/',
  'Card PDF Studio': '/blog/tcg-card-pdf-layout/',
};
---
<BaseLayout title="作品 · nabunana" description="正在构建的项目与工程实验。" pageClass="acg-site" lightingRegister="grove">
  <SiteHeader current="projects" />
  <PageHero eyebrow="作品 / PROJECTS" title={'做一些东西，\n把问题想明白。'} description="每个项目都是一个正在发生的问题：怎样变得更可靠、更清晰、更接近真正可用。" count={`${projects.length} PROJECTS`} />
  <main class="project-page container"><section class="project-index" data-editorial-depth data-reveal-group>{projects.map((project,index)=><MotionBlock hover="project" follow="surface"><article><span data-scroll-reveal>{String(index+1).padStart(2,'0')}</span><div class="project-main" data-scroll-reveal><small>{project.data.tech.join(' / ')}</small><h2><span data-motion-title>{project.data.name}</span></h2><p>{project.data.description}</p><a href={project.data.url || articleByProject[project.data.name] || '/blog/'}>阅读构建记录 <span data-motion-arrow aria-hidden="true">↗</span></a></div><div class="project-status"><i></i><b>{project.data.status}</b><small>ACTIVE LOG</small></div></article></MotionBlock>)}</section></main>
<MotionBlock >  <footer class="project-footer"><div class="container"><p>BUILDING / LEARNING / WRITING</p><strong>代码最终会过时，<br />但解决问题的过程值得留下。</strong></div></footer></MotionBlock>
</BaseLayout>
<style>
  .project-page{padding:clamp(5rem,9vw,9rem) 0}.project-index,.project-index[data-reveal-group]{overflow:visible;border-top:1px solid var(--border)}.project-index article{display:grid;grid-template-columns:54px minmax(0,1fr) 8.5rem;gap:2rem;align-items:start;padding:2rem 2.5rem 2rem 0;border-bottom:1px solid var(--border);transition:padding .25s var(--ease)}.project-index article:hover{padding-left:4px}.project-index article>span{padding-top:.35rem;color:var(--accent);font:.65rem var(--font-mono)}.project-main{min-width:0}.project-main small{color:var(--muted);font:.6rem var(--font-mono);letter-spacing:.08em}.project-main h2{margin:0 0 .6rem;color:var(--strong);font:500 clamp(2rem,4vw,4.3rem)/1.1 var(--font-serif);letter-spacing:-.045em}.project-main p{max-width:680px;margin:0;color:var(--muted)}.project-main a{display:inline-block;margin-top:1rem;color:var(--accent-deep);font-size:.72rem}.project-status{position:relative;z-index:1;display:grid;justify-items:end;gap:.35rem;padding:.35rem .15rem 0 0;width:100%;box-sizing:border-box;white-space:nowrap}.project-status i{width:7px;height:7px;border-radius:50%;background:var(--accent)}.project-status b{font:.65rem var(--font-mono);color:var(--text)}.project-status small{color:var(--muted);font:.5rem var(--font-mono)}.project-footer{padding:7rem 0 9rem;background:#0a201d;color:#e8f3f1}.project-footer p{color:#64c7bd;font:.6rem var(--font-mono);letter-spacing:.13em}.project-footer strong{display:block;margin-top:2rem;font:500 clamp(2.5rem,5vw,5.5rem)/1 var(--font-serif)}
  @media(max-width:700px){.project-index article{grid-template-columns:40px 1fr}.project-status{grid-column:2;justify-self:start;justify-items:start}.project-footer strong br{display:none}}
</style>
