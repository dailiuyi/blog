---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/common/SiteHeader.astro';
import RecordAvatar from '../components/common/RecordAvatar.astro';
import ProjectShowcase from '../components/common/ProjectShowcase.astro';
import { albumStartIndexes, musicAlbums } from '../data/music';
import { getBangumiWatchlist } from '../lib/bangumi';

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.featured)).sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf()).slice(0,4);
const notes = (await getCollection('notes')).sort((a,b)=>b.data.created.valueOf()-a.data.created.valueOf()).slice(0,3);

const watching = getBangumiWatchlist(9);

const nowBeats = [
  { index: '01', kicker: '单曲循环', title: 'Yorushika', desc: '写代码时基本都在单曲循环几张老专辑，听着顺手。' },
  { index: '02', kicker: '在看的动画', title: '葬送的芙莉莲', desc: '节奏比较慢的奇幻公路片，周末有空慢慢看。' },
  { index: '03', kicker: '近期折腾', title: '个人博客', desc: '用 Astro 搭建的静态博客，主要记录踩坑笔记和小工具。' },
  { index: '04', kicker: '常读内容', title: '技术文章与杂文', desc: '后端工程、开源项目实现细节，偶尔看看生活随笔。' },
];
---
<BaseLayout title="nabunana · 写作、音乐与代码" description="nabunana 的个人空间。主要记录 Java、AI 协作与小工具开发，还有常听的音乐。" pageClass="acg-site" lightingRegister="quiet">
  <SiteHeader current="home" />
  <main class="home-page container" id="main">
    <section class="home-intro" aria-labelledby="home-title">
      <div>
        <p class="eyebrow">NABUNANA / PERSONAL SPACE</p>
        <h1 id="home-title">写代码，<br />也留一点时间<br />给<span class="title-hand">喜欢的事。</span></h1>
        <p class="home-description">我是 nabunana，读软件工程大三。平时主要写 Java，也用 AI 辅助写点小工具。<br />这个站用来记录自己做过的项目和踩过的坑，<br />顺便放一放常听的歌和喜欢的动画。</p>
        <div class="live-status-pill" data-live-status>
          <span class="status-indicator">
            <span class="status-dot"></span>
            <span class="status-ping"></span>
          </span>
          <span class="status-location">深圳</span>
          <span class="status-sep">/</span>
          <span class="status-activity">大三 · 编码与小工具</span>
          <span class="status-sep">/</span>
          <a href="#music" class="status-track" data-status-track title="前往常听专辑">
            <span class="track-icon">♫</span>
            <span class="track-name" data-track-name>ノーチラス · Yorushika</span>
          </a>
        </div>
        <div class="intro-actions">
          <a class="button" href="#projects">看看作品 <span aria-hidden="true">↓</span></a>
          <a href="/about/">关于我 ↗</a>
        </div>
      </div>
      <a href="#music" class="hero-record" aria-label="前往常听专辑" data-hero-record>
        <span class="record-top">SIDE A <span>CODE / WORDS / MUSIC</span></span>
        <span class="record-disc"><span class="record-label"><RecordAvatar /></span></span>
        <span class="record-bottom"><span class="record-hand">一些反复听的歌。</span><span>看看常听的歌 ↗</span></span>
      </a>
    </section>

    <nav class="home-index" aria-label="首页章节">
      <span>EXPLORE</span>
      <a href="#projects">01 作品</a>
      <a href="#writing">02 文章</a>
      <a href="#life">03 状态与日常</a>
      <a href="#music">04 常用歌单</a>
    </nav>

    <!-- 01 / SELECTED WORK -->
    <section class="home-section" id="projects" aria-labelledby="projects-title" data-editorial-depth>
      <header class="section-heading">
        <div>
          <p class="eyebrow">01 / SELECTED WORK</p>
          <h2 id="projects-title">做过的一些项目</h2>
        </div>
        <a href="/projects/">全部作品 ↗</a>
      </header>
      <ProjectShowcase />
    </section>

    <!-- 02 / SELECTED WRITING -->
    <section class="home-section" id="writing" aria-labelledby="writing-title" data-editorial-depth>
      <header class="section-heading">
        <div>
          <p class="eyebrow">02 / SELECTED WRITING</p>
          <h2 id="writing-title">最近写的文章与记录</h2>
        </div>
        <a href="/blog/">全部文章 ↗</a>
      </header>
      <div class="home-writing">
        {posts.map(post => (
          <a href={`/blog/${post.id}/`}>
            <div class="post-meta">
              <span>{post.data.category}</span>
              <time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString('zh-CN')}</time>
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="read-link">阅读文章 <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </section>

    <!-- 03 / OFF THE CLOCK: NOW + WATCHING + LIFE NOTES -->
    <section class="home-section" id="life" aria-labelledby="life-title" data-editorial-depth>
      <header class="section-heading">
        <div>
          <p class="eyebrow">03 / OFF THE CLOCK</p>
          <h2 id="life-title">日常状态与记录</h2>
        </div>
        <a href="/about/">认识我 ↗</a>
      </header>

      <!-- 亮点 1: NOW 单焦点状态看板 -->
      <div class="now-widget" data-now-widget>
        <div class="now-focus">
          <small class="now-kicker" data-now-kicker>01 / 单曲循环</small>
          <strong class="now-title" data-now-title>Yorushika</strong>
          <p class="now-desc" data-now-desc>写代码时基本都在单曲循环几张老专辑，听着顺手。</p>
        </div>
        <ul class="now-nav" aria-label="当前状态索引">
          {nowBeats.map((beat, idx) => (
            <li>
              <button
                type="button"
                class={`now-item-btn ${idx === 0 ? 'is-active' : ''}`}
                data-now-index={idx}
                data-title={beat.title}
                data-kicker={`${beat.index} / ${beat.kicker}`}
                data-desc={beat.desc}
              >
                <span class="now-num">{beat.index}</span>
                <span class="now-label">{beat.kicker} · <b>{beat.title}</b></span>
              </button>
            </li>
          ))}
        </ul>
      </div>

      <!-- 亮点 2: Watching 动画展厅轮播 -->
      <div class="watching-section" data-watch-gallery>
        <div class="watch-heading">
          <div>
            <p class="eyebrow">WATCHLIST / 动画展厅</p>
            <h2 class="watch-title">抽空看几部，记一下进度。</h2>
          </div>
          <div class="watch-heading-aside">
            <a href="https://bgm.tv/user/578278" target="_blank" rel="noopener" class="watch-bgm-link" title="前往 Bangumi 个人主页">
              <span>bgm.tv/user/578278</span> ↗
            </a>
            <div class="watch-controls">
              <button type="button" class="watch-ctrl-btn" data-watch-prev aria-label="上一组动画">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
              </button>
              <span class="watch-counter" data-watch-counter aria-live="polite">01 / 03</span>
              <button type="button" class="watch-ctrl-btn" data-watch-next aria-label="下一组动画">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
              </button>
            </div>
          </div>
        </div>

        <div class="watch-stage" data-watch-stage>
          <div class="watch-track" data-watch-track style="--page:0">
            {watching.map((item, index) => (
              <article class="watch-card" data-index={index}>
                <a class="watch-cover" href={item.source} target="_blank" rel="noopener" aria-label={`在 Bangumi 查看《${item.title}》`}>
                  <img
                    src={item.image}
                    alt={`${item.title} 海报封面`}
                    width="600"
                    height="800"
                    loading={index < 3 ? 'eager' : 'lazy'}
                    referrerpolicy="no-referrer"
                  />
                  <span class="watch-badge">{String(index + 1).padStart(2, '0')}</span>
                  <span class={`watch-status-tag ${item.type === 3 ? 'is-doing' : 'is-done'}`}>
                    {item.status}
                  </span>
                  <i class="watch-ext">Bangumi ↗</i>
                </a>
                <div class="watch-meta-slot">
                  <div class="watch-meta-header">
                    <small title={item.meta}>{item.meta}</small>
                    {item.rate > 0 && <span class="watch-rate">★ {item.rate}</span>}
                  </div>
                  <h3>
                    <a href={item.source} target="_blank" rel="noopener" title={item.title}>
                      {item.title}
                    </a>
                  </h3>
                  <div class="watch-progress" role="progressbar" aria-valuenow={item.progress} aria-valuemin="0" aria-valuemax="100">
                    <i style={`width:${item.progress}%`}></i>
                  </div>
                  <footer class="watch-footer">
                    <span>{item.progressText}</span>
                    <b class={item.type === 3 ? 'status-doing' : 'status-done'}>{item.status}</b>
                  </footer>
                  {item.comment && (
                    <p class="watch-user-comment" title={item.comment}>
                      “{item.comment}”
                    </p>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>

        <div class="watch-gallery-footer">
          <div class="watch-dots" data-watch-dots>
            <button type="button" class="watch-dot is-active" data-dot="0" aria-label="第 1 组"></button>
            <button type="button" class="watch-dot" data-dot="1" aria-label="第 2 组"></button>
            <button type="button" class="watch-dot" data-dot="2" aria-label="第 3 组"></button>
          </div>
          <p class="watch-gallery-note">
            <span>展厅同步</span> 记录同步自 Bangumi（构建期随机精选），支持左右滑动与键盘方向键。
          </p>
        </div>
      </div>

      <!-- 个人随笔与短记录 -->
      <div class="life-grid">
        <div class="personal-note">
          <p class="eyebrow">A LITTLE ABOUT ME</p>
          <h3>大三，在找实习。</h3>
          <p>以前打过算法竞赛，现在更喜欢把一个小工具从头写到能用，顺便看看底层是怎么跑的。</p>
          <div>
            <a href="/about/">更多经历与关于我 ↗</a>
            <a href="/blog/summer-anime-list/">夏季动画清单 ↗</a>
          </div>
        </div>
        {notes.length > 0 && (
          <div class="home-notes">
            <div class="home-notes-head">
              <p class="eyebrow">SHORT NOTES</p>
              <a href="/notes/">全部短记录 ↗</a>
            </div>
            <p class="home-notes-lead">最近随手记下的几句想法与日常。</p>
            <ul>
              {notes.map(note => (
                <li>
                  <time datetime={note.data.created.toISOString()}>{note.data.created.toLocaleDateString('zh-CN')}</time>
                  <span>{note.data.title}</span>
                  {note.data.tags.length > 0 && <small>{note.data.tags.join(' · ')}</small>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>

    <!-- 亮点 3: 常听专辑 3D 唱片画廊 -->
    <section class="home-section home-music-section" id="music" aria-labelledby="music-title" data-editorial-depth>
      <header class="section-heading inverse">
        <div>
          <p class="eyebrow">04 / ALBUMS</p>
          <h2 id="music-title">常听的几张专辑</h2>
        </div>
        <div class="music-heading-meta">
          <small>写代码时常听的唱片，支持拖拽切换和点击试听</small>
          <a href="/music/">进入完整曲库 ↗</a>
        </div>
      </header>

      <div class="album-stage" data-album-stage>
        <div class="album-gallery" aria-label="七张专辑唱片廊" aria-roledescription="carousel" data-home-album-carousel>
          {musicAlbums.map((albumItem, index) => (
            <button
              type="button"
              class="album-card"
              style={`--i:${index}`}
              data-album-index={index}
              data-play-index={albumStartIndexes[albumItem.slug]}
              data-track-count={albumItem.tracks.length}
              aria-label={`播放专辑 ${albumItem.title}`}
              tabindex={index === 0 ? 0 : -1}
            >
              <span class="album-cover">
                <img src={albumItem.cover} alt={`${albumItem.title} 专辑封面`} loading={index === 0 ? 'eager' : 'lazy'} />
                <span class="album-play-badge" aria-hidden="true">
                  <svg class="play-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86a1 1 0 0 0-1.5.86z"/>
                  </svg>
                  <svg class="pause-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M6 5h4v14H6zm8 0h4v14h-4z"/>
                  </svg>
                </span>
              </span>
              <span class="album-number">{String(index + 1).padStart(2, '0')} / {albumItem.year}</span>
              <strong>{albumItem.title}</strong>
              <small>{albumItem.artist} · {albumItem.tracks.length} TRACKS</small>
            </button>
          ))}
        </div>
        <div class="album-controls">
          <button type="button" class="album-ctrl-btn" data-album-prev aria-label="上一张专辑">← 上一张</button>
          <span class="album-active-info" data-album-active-info>{musicAlbums[0].title} · {musicAlbums[0].artist}</span>
          <button type="button" class="album-ctrl-btn" data-album-next aria-label="下一张专辑">下一张 →</button>
        </div>
        <p class="gallery-note">
          <span>操作提示</span> 支持鼠标拖拽或方向键切换，点击封面直接开播。
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  let homeAbort: AbortController | undefined;
  function bindHomeInteractions() {
    homeAbort?.abort();
    homeAbort = new AbortController();
    const { signal } = homeAbort;

    // 1. 播放器状态联动
    const heroRecord = document.querySelector<HTMLElement>('[data-hero-record]');
    const trackName = document.querySelector<HTMLElement>('[data-track-name]');
    const playerAudio = document.querySelector<HTMLAudioElement>('.site-player audio');
    if (playerAudio && !playerAudio.paused && heroRecord) {
      heroRecord.dataset.playing = 'true';
    }
    window.addEventListener('nabunana:player-state', (e) => {
      const detail = (e as CustomEvent<{ playing: boolean; trackIndex?: number; album?: string; title?: string; artist?: string }>).detail;
      const isPlaying = !!detail?.playing;
      if (heroRecord) {
        heroRecord.dataset.playing = String(isPlaying);
      }
      if (trackName && detail?.title) {
        trackName.textContent = `${detail.title}${detail.artist ? ' · ' + detail.artist : ''}`;
      }
      const cards = document.querySelectorAll<HTMLButtonElement>('.album-card');
      cards.forEach((card) => {
        const playIdx = Number.parseInt(card.dataset.playIndex || '-1', 10);
        const count = Number.parseInt(card.dataset.trackCount || '0', 10);
        const isCurrentAlbum = detail?.trackIndex !== undefined && detail.trackIndex >= playIdx && detail.trackIndex < playIdx + count;
        card.dataset.playing = String(isPlaying && isCurrentAlbum);
      });
    }, { signal });

    // 2. 亮点 1: NOW 单焦点状态看板交互
    const nowWidget = document.querySelector<HTMLElement>('[data-now-widget]');
    if (nowWidget) {
      const kickerEl = nowWidget.querySelector<HTMLElement>('[data-now-kicker]');
      const titleEl = nowWidget.querySelector<HTMLElement>('[data-now-title]');
      const descEl = nowWidget.querySelector<HTMLElement>('[data-now-desc]');
      const buttons = nowWidget.querySelectorAll<HTMLButtonElement>('.now-item-btn');

      const setNowFocus = (btn: HTMLButtonElement) => {
        buttons.forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        if (kickerEl && btn.dataset.kicker) kickerEl.textContent = btn.dataset.kicker;
        if (titleEl && btn.dataset.title) titleEl.textContent = btn.dataset.title;
        if (descEl && btn.dataset.desc) descEl.textContent = btn.dataset.desc;
      };

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => setNowFocus(btn), { signal });
        btn.addEventListener('mouseenter', () => setNowFocus(btn), { signal });
      });
    }

    // 2.5 亮点 2: 动画展厅轮播交互
    const watchGallery = document.querySelector<HTMLElement>('[data-watch-gallery]');
    if (watchGallery) {
      const track = watchGallery.querySelector<HTMLElement>('[data-watch-track]');
      const prevBtn = watchGallery.querySelector<HTMLButtonElement>('[data-watch-prev]');
      const nextBtn = watchGallery.querySelector<HTMLButtonElement>('[data-watch-next]');
      const counterEl = watchGallery.querySelector<HTMLElement>('[data-watch-counter]');
      const dotBtns = watchGallery.querySelectorAll<HTMLButtonElement>('.watch-dot');
      const cards = watchGallery.querySelectorAll<HTMLElement>('.watch-card');
      const totalCards = cards.length;

      const getItemsPerPage = () => {
        if (window.innerWidth < 640) return 1;
        if (window.innerWidth < 900) return 2;
        return 3;
      };

      let currentPage = 0;
      const getTotalPages = () => Math.ceil(totalCards / getItemsPerPage());

      const updateWatchGallery = (page: number) => {
        const maxPage = Math.max(0, getTotalPages() - 1);
        currentPage = Math.max(0, Math.min(maxPage, page));

        if (track) {
          track.style.setProperty('--page', String(currentPage));
        }
        if (counterEl) {
          counterEl.textContent = `${String(currentPage + 1).padStart(2, '0')} / ${String(maxPage + 1).padStart(2, '0')}`;
        }
        dotBtns.forEach((dot, idx) => {
          dot.classList.toggle('is-active', idx === currentPage);
        });
        if (prevBtn) prevBtn.disabled = currentPage === 0;
        if (nextBtn) nextBtn.disabled = currentPage === maxPage;
      };

      prevBtn?.addEventListener('click', () => updateWatchGallery(currentPage - 1), { signal });
      nextBtn?.addEventListener('click', () => updateWatchGallery(currentPage + 1), { signal });

      dotBtns.forEach((dot, idx) => {
        dot.addEventListener('click', () => updateWatchGallery(idx), { signal });
      });

      // 键盘左右方向键
      watchGallery.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          updateWatchGallery(currentPage - 1);
        } else if (e.key === 'ArrowRight') {
          updateWatchGallery(currentPage + 1);
        }
      }, { signal });

      // 水平触摸/拖拽手势
      let touchStartX = 0;
      let touchDeltaX = 0;
      track?.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
        touchDeltaX = 0;
      }, { signal, passive: true });

      track?.addEventListener('touchmove', (e) => {
        touchDeltaX = e.touches[0].clientX - touchStartX;
      }, { signal, passive: true });

      track?.addEventListener('touchend', () => {
        if (Math.abs(touchDeltaX) > 40) {
          if (touchDeltaX > 0) updateWatchGallery(currentPage - 1);
          else updateWatchGallery(currentPage + 1);
        }
      }, { signal });

      window.addEventListener('resize', () => updateWatchGallery(currentPage), { signal, passive: true });

      updateWatchGallery(0);
    }

    // 3. 亮点 3: 3D 黑胶画廊交互 (支持水平拖拽、按键切换、点击播放)
    const albumStage = document.querySelector<HTMLElement>('[data-album-stage]');
    const albumGallery = document.querySelector<HTMLElement>('[data-home-album-carousel]');
    if (albumStage && albumGallery) {
      const cards = Array.from(albumGallery.querySelectorAll<HTMLButtonElement>('.album-card'));
      const activeInfo = albumStage.querySelector<HTMLElement>('[data-album-active-info]');
      const prevBtn = albumStage.querySelector<HTMLButtonElement>('[data-album-prev]');
      const nextBtn = albumStage.querySelector<HTMLButtonElement>('[data-album-next]');
      const total = cards.length;
      let currentIndex = 0;
      let isDragging = false;
      let startX = 0;
      let startProgress = 0;
      let dragDistance = 0;

      const updateGallery = (idx: number) => {
        currentIndex = Math.max(0, Math.min(total - 1, idx));
        albumGallery.style.setProperty('--p', (currentIndex / Math.max(1, total - 1)).toFixed(4));
        cards.forEach((card, i) => {
          card.tabIndex = i === currentIndex ? 0 : -1;
          if (i === currentIndex) card.setAttribute('aria-current', 'true');
          else card.removeAttribute('aria-current');
        });
        const currentCard = cards[currentIndex];
        if (activeInfo && currentCard) {
          const strong = currentCard.querySelector('strong')?.textContent || '';
          const small = currentCard.querySelector('small')?.textContent || '';
          activeInfo.textContent = `${strong} · ${small}`;
        }
      };

      updateGallery(0);

      prevBtn?.addEventListener('click', () => updateGallery(currentIndex - 1), { signal });
      nextBtn?.addEventListener('click', () => updateGallery(currentIndex + 1), { signal });

      // 水平拖拽
      albumGallery.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        isDragging = true;
        dragDistance = 0;
        startX = e.clientX;
        startProgress = currentIndex;
        albumGallery.classList.add('is-dragging');
      }, { signal });

      albumGallery.addEventListener('pointermove', (e) => {
        if (!isDragging) return;
        const dx = e.clientX - startX;
        dragDistance = Math.abs(dx);
        if (dragDistance > 6 && !albumGallery.hasPointerCapture(e.pointerId)) {
          try { albumGallery.setPointerCapture(e.pointerId); } catch (_) {}
        }
        const cardWidth = 240;
        const nextProgress = startProgress - dx / cardWidth;
        const clampedProgress = Math.max(0, Math.min(total - 1, nextProgress));
        albumGallery.style.setProperty('--p', (clampedProgress / (total - 1)).toFixed(4));
      }, { signal });

      const onPointerEnd = (e: PointerEvent) => {
        if (!isDragging) return;
        isDragging = false;
        albumGallery.classList.remove('is-dragging');
        if (albumGallery.hasPointerCapture(e.pointerId)) {
          try { albumGallery.releasePointerCapture(e.pointerId); } catch (_) {}
        }
        const p = Number.parseFloat(albumGallery.style.getPropertyValue('--p') || '0');
        const targetIndex = Math.round(p * (total - 1));
        updateGallery(targetIndex);
        setTimeout(() => { dragDistance = 0; }, 60);
      };

      albumGallery.addEventListener('pointerup', onPointerEnd, { signal });
      albumGallery.addEventListener('pointercancel', onPointerEnd, { signal });

      const handleCardAction = (index: number) => {
        const card = cards[index];
        if (!card) return;
        updateGallery(index);
        const playIdxStr = card.dataset.playIndex;
        if (playIdxStr !== undefined) {
          const playIdx = Number.parseInt(playIdxStr, 10);
          const isPlaying = card.dataset.playing === 'true';
          if (isPlaying) {
            window.dispatchEvent(new CustomEvent('nabunana:toggle-play'));
          } else {
            window.dispatchEvent(new CustomEvent('nabunana:play-track', { detail: playIdx }));
          }
        }
      };

      // 点击封面
      cards.forEach((card, index) => {
        card.addEventListener('click', (e) => {
          if (dragDistance > 6) {
            e.preventDefault();
            return;
          }
          handleCardAction(index);
        }, { signal });
      });

      // 键盘左右方向键
      albumGallery.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          updateGallery(currentIndex - 1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          updateGallery(currentIndex + 1);
        }
      }, { signal });
    }

    // 4. 亮点 4: 文档流微景深视差 (--enter)
    const depthElements = document.querySelectorAll<HTMLElement>('[data-editorial-depth]');
    if (depthElements.length > 0) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-entered');
          }
        }
      }, { rootMargin: '0px 0px -50px 0px', threshold: 0.08 });
      depthElements.forEach(el => observer.observe(el));
    }
  }

  document.addEventListener('astro:page-load', bindHomeInteractions);
  bindHomeInteractions();
</script>

