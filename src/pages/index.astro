---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/common/SiteHeader.astro';
import RecordAvatar from '../components/common/RecordAvatar.astro';
import ProjectShowcase from '../components/common/ProjectShowcase.astro';
import { musicAlbums } from '../data/music';
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.featured)).sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf()).slice(0,4);
const album = musicAlbums.find(album => album.slug === 'elma') ?? musicAlbums[0];
const notes = (await getCollection('notes')).sort((a,b)=>b.data.created.valueOf()-a.data.created.valueOf()).slice(0,3);
---
<BaseLayout title="nabunana · 写作、音乐与代码" description="nabunana 的个人空间。主要记录 Java、AI 协作与小工具开发，还有常听的音乐。" pageClass="acg-site" lightingRegister="quiet">
  <SiteHeader current="home" />
  <main class="home-page container" id="main">
    <section class="home-intro" aria-labelledby="home-title"><div><p class="eyebrow">NABUNANA / PERSONAL SPACE</p><h1 id="home-title">写代码，<br />也留一点时间<br />给<span class="title-hand">喜欢的事。</span></h1><p class="home-description">我是 nabunana，读软件工程大三。平时主要写 Java，也用 AI 辅助写点小工具。<br />这个站用来记录自己做过的项目和踩过的坑，<br />顺便放一放常听的歌和喜欢的动画。</p>
      <div class="live-status-pill" data-live-status>
        <span class="status-indicator">
          <span class="status-dot"></span>
          <span class="status-ping"></span>
        </span>
        <span class="status-location">深圳</span>
        <span class="status-sep">/</span>
        <span class="status-activity">大三 · 编码与小工具</span>
        <span class="status-sep">/</span>
        <a href="/music/" class="status-track" data-status-track title="前往音乐页查看曲库">
          <span class="track-icon">♫</span>
          <span class="track-name" data-track-name>ノーチラス · Yorushika</span>
        </a>
      </div>
      <div class="intro-actions"><a class="button" href="#projects">看看作品 <span aria-hidden="true">↓</span></a><a href="/about/">关于我 ↗</a></div></div>
      <a href="/music/" class="hero-record" aria-label="进入音乐档案" data-hero-record><span class="record-top">SIDE A <span>CODE / WORDS / MUSIC</span></span><span class="record-disc"><span class="record-label"><RecordAvatar /></span></span><span class="record-bottom"><span class="record-hand">一些反复听的歌。</span><span>打开音乐档案 ↗</span></span></a>
    </section>
    <nav class="home-index" aria-label="首页章节"><span>EXPLORE</span><a href="#projects">01 作品</a><a href="#writing">02 文章</a><a href="#life">03 日常</a></nav>
    <section class="home-section" id="projects" aria-labelledby="projects-title"><header class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2 id="projects-title">做过的一些项目</h2></div><a href="/projects/">全部作品 ↗</a></header><ProjectShowcase /></section>
    <section class="home-section" id="writing" aria-labelledby="writing-title"><header class="section-heading"><div><p class="eyebrow">02 / SELECTED WRITING</p><h2 id="writing-title">最近写的文章与记录</h2></div><a href="/blog/">全部文章 ↗</a></header><div class="home-writing">{posts.map(post => <a href={`/blog/${post.id}/`}><div class="post-meta"><span>{post.data.category}</span><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString('zh-CN')}</time></div><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="read-link">阅读文章 <span aria-hidden="true">↗</span></span></a>)}</div></section>
    <section class="home-section" id="life" aria-labelledby="life-title"><header class="section-heading"><div><p class="eyebrow">03 / OFF THE CLOCK</p><h2 id="life-title">听歌与闲聊</h2></div></header><div class="life-grid"><a class="music-note" href="/music/"><img src={album.cover} width="400" height="400" alt={`${album.title} 专辑封面`} loading="lazy" /><div><span class="eyebrow">LISTENING ROOM</span><h3>反复听的歌。</h3><p>主要是 Yorushika、n-buna 和一些 Vocaloid。<br />写代码时基本都在单曲循环。</p><span class="read-link">进入音乐页 ↗</span></div></a><div class="personal-note"><p class="eyebrow">A LITTLE ABOUT ME</p><h3>大三，在找实习。</h3><p>以前打过算法竞赛，现在更喜欢把一个小工具从头写到能用，顺便看看底层是怎么跑的。</p><div><a href="/about/">认识我 ↗</a><a href="/blog/summer-anime-list/">动画记录 ↗</a></div></div></div>{notes.length > 0 && <div class="home-notes"><div class="home-notes-head"><p class="eyebrow">SHORT NOTES</p><a href="/notes/">全部短记录 ↗</a></div><p class="home-notes-lead">最近随手记下的几句。</p><ul>{notes.map(note=><li><time datetime={note.data.created.toISOString()}>{note.data.created.toLocaleDateString('zh-CN')}</time><span>{note.data.title}</span>{note.data.tags.length > 0 && <small>{note.data.tags.join(' · ')}</small>}</li>)}</ul></div>}</section>
  </main>
</BaseLayout>
<script>
  let homeAbort: AbortController | undefined;
  function bindHomeInteractions() {
    homeAbort?.abort();
    homeAbort = new AbortController();
    const { signal } = homeAbort;
    const heroRecord = document.querySelector<HTMLElement>('[data-hero-record]');
    const trackName = document.querySelector<HTMLElement>('[data-track-name]');
    
    // Check if player is currently playing
    const playerAudio = document.querySelector<HTMLAudioElement>('.site-player audio');
    if (playerAudio && !playerAudio.paused && heroRecord) {
      heroRecord.dataset.playing = 'true';
    }
    
    window.addEventListener('nabunana:player-state', (e) => {
      const detail = (e as CustomEvent<{ playing: boolean; title?: string; artist?: string }>).detail;
      const isPlaying = detail?.playing;
      if (heroRecord) {
        heroRecord.dataset.playing = String(!!isPlaying);
      }
      if (trackName && detail?.title) {
        trackName.textContent = `${detail.title}${detail.artist ? ' · ' + detail.artist : ''}`;
      }
    }, { signal });
  }
  document.addEventListener('astro:page-load', bindHomeInteractions);
  bindHomeInteractions();
</script>
<style>
  .home-intro{display:grid;grid-template-columns:1.3fr 1fr;gap:70px;align-items:center;padding:100px 0 82px}.home-intro .eyebrow{margin-bottom:28px}h1{font:600 clamp(40px,5vw,68px)/1.2 var(--font-sans);letter-spacing:-.065em;margin:0 0 26px}.title-hand{font-family:var(--font-hand);font-weight:500;color:var(--accent-deep)}.home-description{font-size:15px;line-height:1.95;color:var(--muted)}
  .live-status-pill{display:inline-flex;align-items:center;flex-wrap:wrap;gap:8px 12px;margin-top:24px;padding:7px 16px;border-radius:999px;background:color-mix(in srgb,var(--surface) 80%,transparent);border:1px solid var(--border);box-shadow:0 4px 16px rgba(0,0,0,0.02);font:11.5px/1.4 var(--font-mono);color:var(--muted);backdrop-filter:blur(8px);transition:border-color .2s}
  .live-status-pill:hover{border-color:color-mix(in srgb,var(--border) 60%,var(--accent))}
  .status-indicator{position:relative;display:inline-flex;align-items:center;justify-content:center;width:9px;height:9px}
  .status-dot{width:7px;height:7px;border-radius:50%;background:#27c93f}
  .status-ping{position:absolute;width:100%;height:100%;border-radius:50%;background:#27c93f;opacity:.75;animation:status-ping-anim 2.5s cubic-bezier(0,0,.2,1) infinite}
  @keyframes status-ping-anim{0%{transform:scale(1);opacity:.8}75%,100%{transform:scale(2.5);opacity:0}}
  .status-location{font-weight:500;color:var(--text)}
  .status-sep{opacity:.35}
  .status-activity{color:var(--muted)}
  .status-track{display:inline-flex;align-items:center;gap:6px;color:var(--accent-deep);transition:opacity .2s;text-decoration:none}
  .status-track:hover{opacity:.8;text-decoration:underline;text-underline-offset:3px}
  .track-icon{font-size:12px;line-height:1;color:var(--accent)}
  .intro-actions{display:flex;align-items:center;gap:28px;margin-top:30px;font-size:13px}.intro-actions>.button{font-size:13px;padding:12px 22px;border-radius:8px}.hero-record{display:block;width:100%;max-width:340px;justify-self:end;padding:24px;border:1px solid var(--border);background:var(--surface);box-shadow:0 16px 36px #243d2910,inset 0 1px 0 rgba(255,255,255,0.4);transform:rotate(5deg);transition:transform .35s,box-shadow .35s;border-radius:12px;backdrop-filter:blur(8px)}.hero-record:hover{transform:rotate(0) translateY(-3px);box-shadow:0 24px 44px #243d2918,inset 0 1px 0 rgba(255,255,255,0.6)}.record-top,.record-bottom{display:flex;justify-content:space-between;align-items:center;gap:12px;color:var(--muted);font:9px var(--font-mono)}.record-top span{font-size:8px}.record-disc{display:grid;place-items:center;aspect-ratio:1;border-radius:50%;margin:24px 0;background:repeating-radial-gradient(circle,#263f38 0 1px,#19342c 2px 4px);box-shadow:0 7px 18px #173c2928,inset 0 0 0 2px rgba(255,255,255,0.08)}.record-label{display:block;width:38%;height:38%;border-radius:50%;animation:vinyl-spin 20s linear infinite paused;transition:transform .4s}.hero-record[data-playing='true'] .record-label{animation-play-state:running}.hero-record:hover .record-label{animation-play-state:running}@keyframes vinyl-spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}.record-hand{font:14px var(--font-hand)}.record-bottom>span:last-child{font-size:9px}.home-index{display:flex;gap:32px;align-items:center;border-block:1px solid var(--border);padding:19px 0;font-size:12px}.home-index>span{font:10px var(--font-mono);color:var(--muted);margin-right:auto}.home-index a:hover{color:var(--accent-deep)}.home-section{padding:64px 0;scroll-margin-top:24px}.home-section+.home-section{border-top:1px solid var(--border)}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:32px}.section-heading .eyebrow{margin-bottom:12px}.section-heading h2{font-size:clamp(23px,3vw,32px);font-weight:500;letter-spacing:-.045em;margin:0}.section-heading>a{flex-shrink:0;font-size:12px;color:var(--accent-deep);padding-bottom:5px}.home-writing{display:grid;grid-template-columns:1fr 1fr;gap:0 44px}.home-writing>a{display:block;padding:27px 0;border-top:1px solid var(--border);transition:transform .2s ease}.home-writing>a:hover{transform:translateX(4px)}.post-meta{display:flex;justify-content:space-between;gap:10px;font:10px var(--font-mono);color:var(--muted)}.post-meta>span{color:var(--accent-deep)}.home-writing h3{font-size:20px;line-height:1.55;letter-spacing:-.03em;font-weight:500;margin:16px 0 12px}.home-writing p{font-size:13px;line-line:1.85;color:var(--muted);margin:0 0 18px}.read-link{font-size:12px;color:var(--accent-deep)}.home-writing a:hover h3{text-decoration:underline;text-underline-offset:5px}.life-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:26px}.music-note{display:flex;gap:24px;align-items:center;padding:28px;background:var(--surface-2);border:1px solid var(--border);border-radius:16px;box-shadow:0 8px 24px rgba(0,0,0,0.02);transition:transform .3s ease,box-shadow .3s ease}.music-note:hover{transform:translateY(-3px);box-shadow:0 16px 36px rgba(0,0,0,0.05)}.music-note img{width:36%;height:auto;aspect-ratio:1;object-fit:cover;transform:rotate(-5deg);box-shadow:0 10px 25px #102f2415;transition:transform .3s;border-radius:8px}.music-note:hover img{transform:rotate(0)}.life-grid h3{font-size:22px;font-weight:500;line-height:1.5;margin:12px 0}.life-grid p:not(.eyebrow){font-size:13px;color:var(--muted);line-height:1.85}.music-note .eyebrow{font-size:9px}.personal-note{padding:28px;border:1px solid var(--border);border-radius:16px;box-shadow:0 8px 24px rgba(0,0,0,0.02);transition:transform .3s ease,box-shadow .3s ease}.personal-note:hover{transform:translateY(-3px);box-shadow:0 16px 36px rgba(0,0,0,0.05)}.personal-note>div{display:flex;gap:25px;margin-top:20px;font-size:12px;color:var(--accent-deep)}.home-notes{margin-top:26px;padding:24px 28px;border:1px solid var(--border);border-radius:16px;box-shadow:0 8px 24px rgba(0,0,0,0.02)}.home-notes-head{display:flex;justify-content:space-between;align-items:baseline;gap:16px}.home-notes-head .eyebrow{font-size:9px;margin:0}.home-notes-head>a{font-size:12px;color:var(--accent-deep)}.home-notes-lead{font-size:13px;color:var(--muted);line-height:1.85;margin:10px 0 0}.home-notes ul{list-style:none;margin:6px 0 0;padding:0}.home-notes li{display:flex;align-items:baseline;gap:16px;padding:12px 0;border-top:1px solid var(--border);transition:padding-left .2s ease}.home-notes li:hover{padding-left:4px}.home-notes time{flex-shrink:0;color:var(--muted);font:10px var(--font-mono)}.home-notes li>span{font-size:14px}.home-notes small{margin-left:auto;flex-shrink:0;color:var(--muted);font:10px var(--font-mono)}
  @media(max-width:760px){.home-intro{gap:36px;padding:60px 0;grid-template-columns:1fr}.hero-record{max-width:260px;justify-self:center;margin:6px 0 12px}.live-status-pill{margin-top:18px}.home-index{gap:22px}.home-index>span{display:none}.home-section{padding:42px 0}.home-writing,.life-grid{grid-template-columns:1fr}.section-heading{align-items:center}.section-heading h2{font-size:23px}.home-writing h3{font-size:19px}.music-note{padding:22px;gap:20px}.life-grid h3{font-size:20px}.home-description{font-size:14px}.home-notes{padding:20px 22px}.home-notes li{flex-wrap:wrap;gap:6px 16px}.home-notes small{margin-left:0;width:100%}}
  @media(prefers-reduced-motion:reduce){.hero-record,.music-note img,.record-label,.status-ping{transition:none;animation:none}}
</style>
