---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/common/SiteHeader.astro';
import PageHero from '../components/common/PageHero.astro';
import { musicAlbums, albumStartIndexes } from '../data/music';
const posts=(await getCollection('blog',({data})=>!data.draft)).filter(post=>/music|acg|音乐|动画/i.test(`${post.data.category} ${post.data.tags.join(' ')}`));
const trackCount=musicAlbums.reduce((sum,album)=>sum+album.tracks.length,0);
---
<BaseLayout title="音乐 · nabunana" description="Yorushika、n-buna 与 Vocaloid。反复听的专辑、逐曲歌词与兴趣记录。" pageClass="acg-site" lightingRegister="quiet">
  <SiteHeader current="music" /><PageHero eyebrow="音乐 / LISTENING ROOM" title="一些反复听的歌。" description="Yorushika、n-buna 与 Vocaloid。点击专辑封面开始播放，歌词会在播放器中同步显示。" count={`${musicAlbums.length} ALBUMS / ${trackCount} TRACKS`} />
  <main id="main" class="listening-page container"><p class="library-caption">耳机戴好了吗？<span>n-buna / ヨルシカ</span></p><div class="album-grid">{musicAlbums.map(album=><button class="album" type="button" data-listen-index={albumStartIndexes[album.slug]} aria-label={`播放 ${album.artist} 的专辑《${album.title}》`}><span class="cover"><img src={album.cover} alt={`${album.title} 专辑封面`} width="600" height="600" loading="lazy" /><span class="play-mark" aria-hidden="true">▶</span></span><span class="album-meta"><span>{album.year} / {album.tracks.length} TRACKS</span><strong>{album.title}</strong><span>{album.artist}</span></span></button>)}</div><p class="play-feedback" data-play-feedback role="status">选择一张专辑，从第一首开始。</p><section class="music-reading"><p class="eyebrow">NOTES / 音乐与故事</p><h2>还有一些文字。</h2>{posts.map(post=><a href={`/blog/${post.id}/`}><div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span>↗</span></a>)}</section></main>
</BaseLayout>
<script>
  let musicAbort: AbortController | undefined;
  function bindAlbums(){
    musicAbort?.abort();musicAbort=new AbortController();
    const { signal } = musicAbort;
    document.querySelectorAll<HTMLButtonElement>('[data-listen-index]').forEach(button=>button.addEventListener('click',()=>{
      const index=Number(button.dataset.listenIndex);
      if(!Number.isInteger(index))return;
      window.dispatchEvent(new CustomEvent('nabunana:play-track',{detail:index}));
      const feedback=document.querySelector('[data-play-feedback]');
      if(feedback)feedback.textContent=`已选择《${button.querySelector('strong')?.textContent}》，可在播放器中暂停或切换。`;
    },{signal}));
  }
  document.addEventListener('astro:page-load',bindAlbums);bindAlbums();
</script>
<style>
  .listening-page{padding-block:30px 64px}.library-caption{display:flex;justify-content:space-between;gap:20px;color:var(--muted);font-size:13px;margin:0 0 32px}.library-caption>span{font:11px var(--font-mono)}.album-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px 28px}.album{display:block;text-align:left;background:none;padding:0;border:0;color:var(--text);cursor:pointer;min-width:0}.cover{position:relative;display:block;aspect-ratio:1;overflow:hidden;border-radius:8px;border:1px solid var(--border);background:var(--surface-2)}.cover img{width:100%;height:100%;object-fit:cover;transition:transform .3s}.album:hover img{transform:scale(1.035)}.play-mark{position:absolute;right:16px;bottom:16px;display:grid;place-items:center;width:42px;height:42px;background:#153a32db;color:#fff;border:1px solid #ffffff80;border-radius:50%;font-size:13px}.album-meta{display:grid;gap:8px;padding-top:18px}.album-meta>span{font:10px var(--font-mono);color:var(--muted)}.album-meta strong{font:500 19px/1.5 var(--font-sans)}.play-feedback{color:var(--muted);font-size:12px;margin-top:32px}.music-reading{margin-top:55px;padding-top:40px;border-top:1px solid var(--border)}h2{font-size:26px;font-weight:500;margin:12px 0 28px}.music-reading>a{display:flex;justify-content:space-between;gap:20px;padding:22px 0;border-top:1px solid var(--border)}h3{font-size:19px;font-weight:500;margin:0 0 10px}.music-reading p:not(.eyebrow){font-size:13px;line-height:1.8;color:var(--muted)}.music-reading>a>span{color:var(--accent-deep)}@media(max-width:650px){.album-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:26px 18px}.album-meta strong{font-size:15px}.album-meta>span{font-size:9px}.play-mark{width:34px;height:34px;right:10px;bottom:10px}.library-caption{font-size:12px}.library-caption>span{font-size:10px}}@media(prefers-reduced-motion:reduce){.cover img{transition:none}}
</style>
