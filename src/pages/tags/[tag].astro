---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/common/SiteHeader.astro';
import PageHero from '../../components/common/PageHero.astro';
import { buildTagSlugMap } from '../../lib/tag-slug';

export async function getStaticPaths(){
  const posts = await getCollection('blog', ({data})=>!data.draft);
  const tags = [...new Set(posts.flatMap(post=>post.data.tags))].sort((a,b)=>a.localeCompare(b,'zh-CN'));
  const slugByTag = buildTagSlugMap(tags);
  return tags.map(tag=>({params:{tag:slugByTag.get(tag)},props:{tag}}));
}
const { tag } = Astro.props;
const posts = (await getCollection('blog', ({data})=>!data.draft)).filter(post=>post.data.tags.includes(tag)).sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf());
---
<BaseLayout title={`${tag} · 标签 · nabunana`} description={`与「${tag}」有关的文章，共 ${posts.length} 篇。`} pageClass="acg-site" lightingRegister="quiet">
  <SiteHeader current="writing" /><PageHero eyebrow="标签 / TAG" title={`#${tag}`} description={`与「${tag}」有关的记录，按时间从新到旧排列。`} count={`${posts.length} ENTRIES`} />
  <main id="main" class="tag-page container"><nav class="tag-nav" aria-label="相关页面"><a href="/tags/">全部标签 ↗</a><a href="/archive/">按时间浏览 ↗</a></nav><div class="article-list">{posts.map(post=><article><div class="entry-meta"><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString('zh-CN')}</time><span>{post.data.category}</span></div><a href={`/blog/${post.id}/`}><h2>{post.data.title}</h2><p>{post.data.description}</p><div class="entry-bottom"><span>{post.data.tags.slice(0,3).join(' / ')}</span><span>{post.data.readingTime} ↗</span></div></a></article>)}</div></main>
</BaseLayout>
<style>
  .tag-page{padding-block:30px 64px}.tag-nav{display:flex;gap:24px;margin-bottom:24px;font-size:13px}.tag-nav a{color:var(--accent-deep)}.article-list article{display:grid;grid-template-columns:150px minmax(0,1fr);gap:40px;padding:30px 0;border-top:1px solid var(--border)}.entry-meta{display:grid;align-content:start;gap:10px;padding-top:6px;color:var(--muted);font:11px/1.6 var(--font-mono)}.entry-meta span{color:var(--accent-deep)}h2{font:500 23px/1.5 var(--font-sans);letter-spacing:-.025em;margin:0 0 12px}.article-list p{max-width:760px;margin:0;font-size:14px;line-height:1.9;color:var(--muted)}.entry-bottom{display:flex;justify-content:space-between;gap:20px;margin-top:20px;color:var(--muted);font:10px/1.7 var(--font-mono)}a:hover h2{text-decoration:underline;text-underline-offset:5px}@media(max-width:650px){.article-list article{grid-template-columns:1fr;gap:12px}.entry-meta{display:flex;gap:20px}h2{font-size:20px}.article-list p{font-size:13px}.entry-bottom{flex-wrap:wrap}}
</style>
