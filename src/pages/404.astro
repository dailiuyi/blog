---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/common/SiteHeader.astro';
import PageHero from '../components/common/PageHero.astro';
const posts = (await getCollection('blog', ({data})=>!data.draft)).sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf()).slice(0,3);
---
<BaseLayout title="页面没有找到 · nabunana" description="这个地址没有对应的内容。可以打开搜索，或从最近的文章继续阅读。" pageClass="acg-site" lightingRegister="quiet">
  <SiteHeader current="home" /><PageHero eyebrow="404 / NOT FOUND" title="这一页不在这里。" description="地址可能拼错了，也可能已经搬走。可以搜索站内内容，或者从最近的三篇记录继续。" />
  <main id="main" class="notfound-page container"><div class="notfound-actions"><button type="button" class="search-button" data-search-open>搜索站内内容 ↗</button><a href="/">回到首页 ↗</a><a href="/blog/">全部文章 ↗</a></div><section class="recent-posts" aria-labelledby="recent-title"><h2 id="recent-title">最近更新</h2>{posts.map(post=><article><div class="entry-meta"><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString('zh-CN')}</time><span>{post.data.category}</span></div><a href={`/blog/${post.id}/`}><h3>{post.data.title}</h3><p>{post.data.description}</p></a></article>)}</section></main>
</BaseLayout>
<style>
  .notfound-page{padding-block:40px 64px}.notfound-actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px 24px}.search-button{padding:0;border:0;background:transparent;color:var(--accent-deep);font-size:13px;cursor:pointer}.notfound-actions>a{font-size:13px;color:var(--accent-deep)}.recent-posts{margin-top:48px}.recent-posts h2{font:500 23px/1.5 var(--font-sans);letter-spacing:-.025em;margin:0 0 16px}.recent-posts article{display:grid;grid-template-columns:150px minmax(0,1fr);gap:40px;padding:26px 0;border-top:1px solid var(--border)}.entry-meta{display:grid;align-content:start;gap:10px;padding-top:4px;color:var(--muted);font:11px/1.6 var(--font-mono)}.entry-meta span{color:var(--accent-deep)}.recent-posts h3{font:500 20px/1.5 var(--font-sans);letter-spacing:-.02em;margin:0 0 10px}.recent-posts p{max-width:760px;margin:0;font-size:14px;line-height:1.9;color:var(--muted)}.recent-posts a:hover h3{text-decoration:underline;text-underline-offset:5px}@media(max-width:650px){.recent-posts article{grid-template-columns:1fr;gap:12px}.entry-meta{display:flex;gap:20px}.recent-posts h3{font-size:18px}}
</style>
