---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/common/SiteHeader.astro';
import PageHero from '../../components/common/PageHero.astro';
import { buildSeriesIndex } from '../../lib/series';

export async function getStaticPaths(){
  const posts = await getCollection('blog', ({data})=>!data.draft);
  return buildSeriesIndex(posts).map(series=>({params:{slug:series.slug},props:{series}}));
}
const { series } = Astro.props;
---
<BaseLayout title={`${series.name} · 系列 · nabunana`} description={`「${series.name}」连载共 ${series.posts.length} 篇，按阅读顺序排列。`} pageClass="acg-site" lightingRegister="quiet">
  <SiteHeader current="writing" /><PageHero eyebrow="系列 / SERIES" title={series.name} description="以下按阅读顺序排列，从前到后依次阅读。" count={`${series.posts.length} ENTRIES`} />
  <main id="main" class="series-page container"><nav class="series-nav" aria-label="相关页面"><a href="/series/">全部系列 ↗</a><a href="/blog/">全部文章 ↗</a></nav><div class="article-list">{series.posts.map((post,index)=><article><div class="entry-meta"><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString('zh-CN')}</time><span>第 {index+1} 篇</span></div><a href={`/blog/${post.id}/`}><h2>{post.data.title}</h2><p>{post.data.description}</p><div class="entry-bottom"><span>{post.data.tags.slice(0,3).join(' / ')}</span><span>{post.data.readingTime} ↗</span></div></a></article>)}</div></main>
</BaseLayout>
<style>
  .series-page{padding-block:30px 64px}.series-nav{display:flex;gap:24px;margin-bottom:24px;font-size:13px}.series-nav a{color:var(--accent-deep)}.series-page .article-list article{display:grid;grid-template-columns:150px minmax(0,1fr);gap:40px;padding:30px 0;border-top:1px solid var(--border)}.series-page .entry-meta{display:grid;align-content:start;gap:10px;padding-top:6px;color:var(--muted);font:11px/1.6 var(--font-mono)}.series-page .entry-meta span{color:var(--accent-deep)}.series-page h2{font:500 23px/1.5 var(--font-sans);letter-spacing:-.025em;margin:0 0 12px}.series-page .article-list p{max-width:760px;margin:0;font-size:14px;line-height:1.9;color:var(--muted)}.series-page .entry-bottom{display:flex;justify-content:space-between;gap:20px;margin-top:20px;color:var(--muted);font:10px/1.7 var(--font-mono)}.series-page a:hover h2{text-decoration:underline;text-underline-offset:5px}@media(max-width:650px){.series-page .article-list article{grid-template-columns:1fr;gap:12px}.series-page .entry-meta{display:flex;gap:20px}.series-page h2{font-size:20px}.series-page .article-list p{font-size:13px}.series-page .entry-bottom{flex-wrap:wrap}}
</style>
