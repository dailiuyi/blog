---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/common/SiteHeader.astro';
import PageHero from '../components/common/PageHero.astro';
const posts = (await getCollection('blog', ({data})=>!data.draft)).sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf());
const years = [...new Set(posts.map(post=>post.data.published.getFullYear()))].sort((a,b)=>b-a);
const archive = years.map(year=>({year,posts:posts.filter(post=>post.data.published.getFullYear()===year)}));
---
<BaseLayout title="归档 · nabunana" description="按时间浏览站内的全部文章。" pageClass="acg-site" lightingRegister="quiet">
  <SiteHeader current="writing" /><PageHero eyebrow="归档 / ARCHIVE" title="按时间翻回去。" description="从最近的一篇开始，一年一年往回看。" count={`${posts.length} ENTRIES`} />
  <main id="main" class="archive-page container">{archive.map(group=><section class="archive-year" aria-labelledby={`year-${group.year}`}><h2 id={`year-${group.year}`}>{group.year}<span>{group.posts.length} 篇</span></h2><div class="archive-rows">{group.posts.map(post=><article><div class="archive-meta"><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString('zh-CN')}</time><span>{post.data.category}</span></div><a href={`/blog/${post.id}/`}><h3>{post.data.title}</h3></a></article>)}</div></section>)}<a class="tag-link" href="/tags/">按标签浏览 ↗</a></main>
</BaseLayout>
<style>
  .archive-page{padding-block:30px 64px}.archive-year{margin-bottom:48px}.archive-year h2{display:flex;align-items:baseline;gap:14px;font:500 30px/1.3 var(--font-sans);letter-spacing:-.03em;margin:0 0 8px}.archive-year h2 span{color:var(--muted);font:10px var(--font-mono)}.archive-rows{border-top:1px solid var(--border)}.archive-rows article{display:grid;grid-template-columns:150px minmax(0,1fr);gap:40px;padding:20px 0;border-bottom:1px solid var(--border)}.archive-meta{display:flex;gap:16px;color:var(--muted);font:11px/1.6 var(--font-mono)}.archive-meta span{color:var(--accent-deep)}.archive-rows h3{font:500 19px/1.6 var(--font-sans);letter-spacing:-.02em;margin:0}.archive-rows a:hover h3{text-decoration:underline;text-underline-offset:5px}.tag-link{display:inline-block;margin-top:8px;font-size:13px;color:var(--accent-deep)}@media(max-width:650px){.archive-year h2{font-size:24px}.archive-rows article{grid-template-columns:1fr;gap:8px}}
</style>
