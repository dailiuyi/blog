---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/common/SiteHeader.astro';
import RecordAvatar from '../components/common/RecordAvatar.astro';
import { selectedProjects as projects } from '../data/selected-projects';
---
<BaseLayout title="关于 · nabunana" description="我是 nabunana。在这里记录 Java、AI 协作与个人项目，也分享音乐、文字和 ACG 兴趣。" pageClass="acg-site" lightingRegister="quiet">
  <SiteHeader current="about" />
  <main id="main" class="personal-page">
    <section class="intro" aria-labelledby="personal-title">
      <div><p class="eyeline">ABOUT ME <span>代码 / 文字 / 音乐</span></p>
        <h1 id="personal-title">你好，<br />我是 <span>nabunana</span><i>。</i></h1>
        <ul class="tags" aria-label="个人方向"><li>Java 后端</li><li>算法与工程</li><li>AI 协作</li><li>Yorushika / n-buna</li></ul>
        <a class="text-link" href="#selected">最近在做的 <span aria-hidden="true">↓</span></a>
      </div>
      <a class="record" href="/music/" aria-label="进入我的音乐页"><span class="record-note">SIDE A / SOMEWHERE IN SUMMER</span><span class="disc"><span class="disc-label"><RecordAvatar /></span></span><span class="record-caption">写代码的时候，也听音乐。<span aria-hidden="true">↗</span></span></a>
    </section>
    <section id="selected" class="section" aria-labelledby="projects-title">
      <div class="section-head"><div><p class="eyeline">01 / SELECTED WORK</p><h2 id="projects-title">做过的一些东西</h2></div><a class="text-link" href="/projects/">全部作品 ↗</a></div>
      <div class="project-grid">{projects.map((p) => <a class="project" href={p.article}><div class="project-thumb">{p.id === 'elma' ? <img src="/media/projects/elma-still.webp" alt="ELMA 小程序界面" loading="lazy" /> : p.id === 'threebody' ? <img src="/media/projects/threebody.webp" alt="三体实验室运行截图" loading="lazy" /> : <div class="code-thumb"><small>minimalloc.c / 源码节选</small><code>#define config_heap 8 * 1024<br />static uint8_t AllHeap[config_heap];</code></div>}</div><div class="project-copy"><h3>{p.name}</h3><span class="project-sub">{p.subtitle}</span><p>{p.description}</p><small>{p.tech.join(' · ')}</small></div></a>)}</div>
      <a class="minor-link" href="/blog/tcg-card-pdf-layout/">还有一个小工具：把 TCG 卡牌排成可打印的 A4 PDF ↗</a>
    </section>
    <section class="section background" aria-labelledby="background-title">
      <div><p class="eyeline">02 / BACKGROUND</p><h2 id="background-title">从算法到工程</h2><p class="section-note">软件工程学习背景。<br />关心原理，也关心实际使用的体验。</p></div>
      <div class="experience-list">
        <article><span class="row-number">01</span><div><h3>算法与底层</h3><p>从算法竞赛开始接触编程，参加过 NOIP、CCPC 与蓝桥杯；继续通过小型项目理解内存、数值计算与系统行为。</p><details><summary>竞赛记录 <span>+</span></summary><p>CCPC 省赛银牌、铜牌与国赛铜牌；蓝桥杯 C/C++ 国赛二等奖、省赛一等奖；NOIP 省级二等奖。</p></details></div></article>
        <article><span class="row-number">02</span><div><h3>后端与交付</h3><p>参与过数据导出、容器部署和 MR 内容管理平台开发，处理接口、数据、文件存储与版本发布。</p><details><summary>技术与实践 <span>+</span></summary><p>Java / Spring Boot / PostgreSQL / MyBatis-Plus / JPA；REST / WebSocket；Docker / Linux。通过 OpenAPI、自动化测试与部署验证检查交付结果。</p><p>数据导出支持模板填充与动态表头；内容管理涉及场景、版本、文件存储与发布审计。</p></details></div></article>
        <article><span class="row-number">03</span><div><h3>与 AI 一起开发</h3><p>使用 Codex、Claude Code 辅助开发，自己负责拆解任务、审查代码、纠错与验证，也记录工具在真实项目中的表现。</p><details><summary>协作方式 <span>+</span></summary><p>先明确目标和边界，再拆分任务；结合源码、测试与实际页面检查结果。前端使用 Vue、TypeScript，也探索 Canvas 与 Three.js。</p></details></div></article>
      </div>
    </section>
    <section class="section" aria-labelledby="offscreen-title">
      <div class="section-head"><div><p class="eyeline">03 / OFF THE CLOCK</p><h2 id="offscreen-title">代码之外</h2></div><span class="handwritten">また、どこかで。</span></div>
      <div class="interest-grid"><a href="/music/"><span class="interest-symbol" aria-hidden="true">♫</span><h3>音乐</h3><p>Yorushika、n-buna、Vocaloid。<br />一些反复听的歌，留在音乐页。</p><span class="text-link">去听听 ↗</span></a><a href="/blog/"><span class="interest-symbol" aria-hidden="true">✎</span><h3>文字与故事</h3><p>记录开发过程，也保留对动画、故事与日常片段的兴趣。</p><span class="text-link">翻翻文章 ↗</span></a></div>
    </section>
    <footer class="personal-footer"><div><p class="eyeline">ELSEWHERE</p><h2>在作品里认识我。</h2><p>代码、构建记录和兴趣，都可以从这里继续。</p><p>开放 Java 后端开发实习 / 校招机会。</p></div><div class="footer-links"><a href="https://github.com/dailiuyi" target="_blank" rel="me noopener noreferrer">GitHub <span>↗</span></a><a href="/blog/">文章 <span>↗</span></a><a href="/rss.xml">订阅 RSS <span>↗</span></a></div><small class="signature">nabunana <span>CODE · WORDS · MUSIC</span></small></footer>
  </main>
</BaseLayout>
<style>
  .personal-page{width:min(1120px,calc(100% - 64px));margin:auto;color:var(--strong)}
  .intro{display:grid;grid-template-columns:1.35fr 1fr;gap:72px;align-items:center;padding:104px 0 88px}.eyeline{display:flex;gap:24px;margin:0 0 24px;font:500 10px/1.6 var(--font-mono);letter-spacing:.15em;color:var(--muted)}.eyeline span{letter-spacing:.06em}
  h1{margin:0 0 28px;font:550 clamp(40px,5.4vw,76px)/1.17 var(--font-sans);letter-spacing:-.065em}h1 span{font-family:Georgia,serif;font-weight:400}h1 i{font-style:normal;color:var(--accent)}.tags{display:flex;flex-wrap:wrap;gap:8px;padding:0;margin:0 0 30px;list-style:none}.tags li{font-size:10px;padding:5px 10px;border:1px solid var(--border);border-radius:4px;color:var(--muted)}.text-link{display:inline-flex;align-items:center;gap:18px;font-size:12px;color:var(--accent-deep)}a:hover .project-arrow{transform:translate(2px,-2px)}
  .record{display:block;padding:24px;background:var(--surface-2);border:1px solid var(--border);transform:rotate(4deg);transition:transform .4s;max-width:370px;justify-self:end;width:100%}.record:hover{transform:rotate(0)}.record-note{display:block;font:8px var(--font-mono);letter-spacing:.12em;color:var(--muted)}.disc{display:grid;place-items:center;aspect-ratio:1;margin:24px 8px;border-radius:50%;background:repeating-radial-gradient(circle,#294641 0 1px,#19352f 2px 5px);box-shadow:5px 12px 20px #132d2520}.disc-label{display:block;width:39%;height:39%;transform:rotate(-14deg);transition:transform 1.2s}.record:hover .disc-label{transform:rotate(26deg)}.record-caption{display:flex;justify-content:space-between;font-size:10px;color:var(--muted)}
  .section{padding:58px 0;border-top:1px solid var(--border);scroll-margin-top:30px}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:30px;gap:20px}.section .eyeline,.personal-footer .eyeline{margin-bottom:12px}h2{margin:0;font-size:25px;line-height:1.5;font-weight:500;letter-spacing:-.035em}.project-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.project{min-width:0}.project-art{position:relative;height:164px;background:var(--surface-2);overflow:hidden;border:1px solid var(--border)}.project-number,.project-arrow{position:absolute;top:15px;font:10px var(--font-mono);color:var(--muted)}.project-number{left:16px}.project-arrow{right:16px;font-size:18px;transition:transform .2s}.project-mark{position:absolute;inset:0;display:grid;place-items:center;font:48px var(--font-serif);color:var(--accent-deep);transition:transform .3s}.project:hover .project-mark{transform:scale(1.08)}.meal .project-mark:before{content:'';position:absolute;width:105px;height:105px;border:1px solid var(--border);border-radius:50%;box-shadow:0 0 0 9px var(--surface-2),0 0 0 10px var(--border)}.orbit .project-mark{font:140px Georgia;transform:rotate(-25deg)}.orbit:hover .project-mark{transform:rotate(0)}.memory .project-mark{font:54px var(--font-mono);letter-spacing:15px}.project-copy{padding:20px 0 0}h3{margin:0;font-size:17px;font-weight:500}.project-sub{display:block;font-size:11px;color:var(--muted);margin-top:3px}.project-copy p{font-size:12px;line-height:1.9;color:var(--muted);margin:13px 0}.project-copy small{font:9px var(--font-mono);color:var(--muted)}.minor-link{display:inline-block;margin-top:28px;font-size:11px;color:var(--muted);text-decoration:underline;text-underline-offset:5px}
  .background{display:grid;grid-template-columns:1fr 1.65fr;gap:60px}.section-note{font-size:12px;color:var(--muted);line-height:1.9;margin-top:20px}.experience-list article{display:grid;grid-template-columns:28px 1fr;gap:16px;padding:23px 0;border-bottom:1px solid var(--border)}.experience-list article:first-child{padding-top:0}.experience-list article:last-child{border:0;padding-bottom:0}.row-number{font:10px var(--font-mono);color:var(--muted);padding-top:6px}.experience-list p{font-size:12px;line-height:1.95;color:var(--muted);margin:10px 0}details{margin-top:14px}summary{display:flex;justify-content:space-between;cursor:pointer;font-size:11px;color:var(--accent-deep);list-style:none;min-height:32px;align-items:center}summary::-webkit-details-marker{display:none}summary span{font-size:18px;transition:transform .2s}details[open] summary span{transform:rotate(45deg)}details[open] p{padding-left:12px;border-left:2px solid var(--border)}.handwritten{color:var(--muted);font:19px var(--font-serif)}.interest-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}.interest-grid>a{position:relative;padding:12px 40px 0 0}.interest-grid>a+a{padding-left:30px;border-left:1px solid var(--border)}.interest-symbol{position:absolute;right:10px;top:0;font:40px Georgia;color:var(--accent);opacity:.6}.interest-grid p{font-size:12px;line-height:1.9;color:var(--muted);max-width:340px}.interest-grid .text-link{font-size:11px}
  .personal-footer{display:grid;grid-template-columns:1.5fr 1fr;gap:34px;padding:55px 0 95px;border-top:1px solid var(--border)}.personal-footer p:not(.eyeline){font-size:12px;color:var(--muted)}.footer-links a{display:flex;justify-content:space-between;padding:13px 0;border-bottom:1px solid var(--border);font-size:12px}.footer-links a:hover{color:var(--accent-deep)}.signature{grid-column:1/-1;display:flex;justify-content:space-between;padding-top:35px;color:var(--muted);font:11px var(--font-mono)}.signature span{font-size:9px;letter-spacing:.1em}
  @media(max-width:760px){.personal-page{width:calc(100% - 40px)}.intro{gap:32px;padding:60px 0;grid-template-columns:1fr}h1{font-size:clamp(42px,10vw,64px)}.record{width:240px;justify-self:center;margin:12px 0}.project-grid{grid-template-columns:1fr;gap:30px}.project{display:grid;grid-template-columns:120px 1fr;gap:18px}.project-art{height:150px}.project-copy{padding:0}.project-copy p{margin:8px 0}.project-mark{font-size:32px}.meal .project-mark:before{width:80px;height:80px}.section{padding:38px 0}.background{grid-template-columns:1fr;gap:24px}.section-note{margin-top:12px}.section-head{align-items:center}h2{font-size:22px}.handwritten{font-size:14px}.interest-grid{gap:20px}.interest-grid>a{padding-right:0}.interest-grid>a+a{padding-left:20px}.interest-symbol{display:none}.personal-footer{grid-template-columns:1fr;gap:20px;padding-bottom:110px}.signature{gap:15px}}
  @media(max-width:360px){.project{grid-template-columns:95px 1fr;gap:12px}.section-head{align-items:start}.handwritten{display:none}}
  .project-thumb{height:190px;background:var(--surface-2);border:1px solid var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;overflow:hidden}.project-thumb img{width:100%;height:100%;object-fit:contain}.code-thumb{min-width:0;padding:20px}.code-thumb small{display:block;font:10px var(--font-mono);color:var(--muted);margin-bottom:20px}.code-thumb code{display:block;font:11px/1.9 var(--font-mono);overflow-wrap:anywhere;color:var(--accent-deep)}
  @media(max-width:760px){.project-thumb{height:150px}.code-thumb{padding:10px}.code-thumb code{font-size:9px}}
  @media(prefers-reduced-motion:reduce){.record,.disc-label,.project-mark,.project-arrow,summary span{transition:none}}
</style>
